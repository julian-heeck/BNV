   3.936179970768202*^9}, {3.9361800047050953`*^9, 3.9361802332121468`*^9}, {
   3.936180268437916*^9, 3.936180500233485*^9}, {3.93619267373958*^9, 
   3.93619267576998*^9}, {3.93619273387601*^9, 3.936192777202879*^9}, {
   3.936192828107841*^9, 3.936192831524253*^9}, 3.9720362175926237`*^9, {
