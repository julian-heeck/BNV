 RowBox[{"Complement", "[", 
  RowBox[{"fulllistNoDuplicates", ",", "finallist"}], "]"}]], "Input",
 CellChangeTimes->{{3.972486685765383*^9, 3.972486693297097*^9}},
 CellLabel->"In[82]:=",ExpressionUUID->"f59c6b4b-c876-4ccd-9160-9c88ce2bb716"],

