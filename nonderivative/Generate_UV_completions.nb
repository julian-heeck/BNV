Cell["\<\
The amplitude is symmetric under p1 <-> p2 exchange, i.e. exchange of the two \
uR fields:\
\>", "Text",
 CellChangeTimes->{{3.972487921396357*^9, 
  3.97248794661296*^9}},ExpressionUUID->"4e975195-03a4-48d3-a4f3-\
0096b4ec5861"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"amp", "[", 
    RowBox[{"p1", ",", "p2", ",", "p3", ",", "p4"}], "]"}], "-", 
   RowBox[{"amp", "[", 
    RowBox[{"p2", ",", "p1", ",", "p3", ",", "p4"}], "]"}]}], "//", 
  "Simplify"}]], "Input",
 CellChangeTimes->{{3.95977054075404*^9, 3.959770557269678*^9}, {
  3.972487901577368*^9, 3.972487910233714*^9}},
 CellLabel->"In[86]:=",ExpressionUUID->"0ac8fc18-0c7b-458f-a88f-3bbeefe5af39"],

Cell[BoxData[
 RowBox[{"{", "0", "}"}]], "Output",
 CellChangeTimes->{{3.959770537031909*^9, 3.959770557523427*^9}, 
   3.960236116121577*^9, 3.960238373294237*^9, 3.9608835957050543`*^9, 
