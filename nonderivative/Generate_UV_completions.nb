 RowBox[{
  RowBox[{"finallist", "=", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{"fulllistNoDuplicates", ",", 
     RowBox[{"x_", "/;", 
      RowBox[{"AsymmetricHiggsQ", "[", "x", "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Length", "[", "finallist", "]"}]}], "Input",
