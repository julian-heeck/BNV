Cell["\<\
If you\[CloseCurlyQuote]re only interested in UV completions involving one \
particular internal particle (and its antiparticle), just look for them in \
the list:\
\>", "Text",
 CellChangeTimes->{{3.982162391566515*^9, 3.982162423724578*^9}, {
  3.98216253911296*^9, 
  3.9821625521124372`*^9}},ExpressionUUID->"93aed51f-18ff-48e6-b25f-\
7cdf27f7e8d7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"whichUVyouwant", "=", "\"\<S[3]\>\""}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"import", "[", 
    RowBox[{"[", "1", "]"}], "]"}], ",", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"import", "[", 
      RowBox[{"[", "2", "]"}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"MemberQ", "[", 
        RowBox[{"#", ",", "whichUVyouwant", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "Infinity"}], "}"}]}], "]"}], "||", 
       RowBox[{"MemberQ", "[", 
        RowBox[{"#", ",", 
         RowBox[{"ConjugateRep", "[", "whichUVyouwant", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "Infinity"}], "}"}]}], "]"}]}], "&"}]}], "]"}]}], 
  "}"}]}], "Input",
 CellChangeTimes->{{3.982162166511866*^9, 3.982162245479929*^9}, {
