        FractionBox["1", "3"]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "1", "}"}], ",", 
       RowBox[{"{", "0", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", "1", "}"}], ",", 
       FractionBox["3", "2"]}], "}"}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.9724885958262978`*^9, 3.972488605047946*^9}, 
