Cell["\<\
the first entry is the topology, the second entry is the list of UV \
completions, using the particle names F[8], S[5], V[1] from our article. \
Vc[2] means the antiparticle of V[2]. We provide simple lookup tables for the \
new particle quantum numbers, contained in the folder \
\[OpenCurlyDoubleQuote]newparticles\[CloseCurlyDoubleQuote]:\
\>", "Text",
 CellChangeTimes->{{3.984314146850572*^9, 3.984314290346438*^9}, {
  3.984316162584894*^9, 3.98431616477614*^9}, {4.004011812101791*^9, 
  4.004011815225298*^9}},ExpressionUUID->"98caf9bd-7a83-45cf-b482-\
c3663ea588d0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"NewScalars", "=", 
   RowBox[{"Join", "@@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Import", "[", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], 
        "<>", "\"\<newparticles/NewScalars_Dim\>\"", "<>", 
        RowBox[{"ToString", "[", "d", "]"}], "<>", "\"\<.wl\>\""}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"d", ",", "6", ",", "15"}], "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NewVectors", "=", 
   RowBox[{"Join", "@@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Import", "[", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], 
        "<>", "\"\<newparticles/NewVectors_Dim\>\"", "<>", 
        RowBox[{"ToString", "[", "d", "]"}], "<>", "\"\<.wl\>\""}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"d", ",", "6", ",", "15"}], "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NewFermions", "=", 
    RowBox[{"Join", "@@", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Import", "[", 
        RowBox[{
         RowBox[{"NotebookDirectory", "[", "]"}], 
         "<>", "\"\<newparticles/NewFermions_Dim\>\"", "<>", 
         RowBox[{"ToString", "[", "d", "]"}], "<>", "\"\<.wl\>\""}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"d", ",", "6", ",", "15"}], "}"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"LookupNewParticle", "[", "x_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "particle", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"particle", "=", 
        RowBox[{"StringCases", "[", 
         RowBox[{"x", ",", 
          RowBox[{
           RowBox[{
           "RegularExpression", "[", "\"\<([A-Za-z]+)\\\\[(\\\\d+)\\\\]\>\"", 
            "]"}], ":>", 
           RowBox[{"{", 
            RowBox[{"\"\<$1\>\"", ",", 
             RowBox[{"ToExpression", "[", "\"\<$2\>\"", "]"}]}], "}"}]}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "particle", "]"}], "!=", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"particle", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], "==", "\"\<S\>\""}], ",", 
            RowBox[{"Return", "[", 
             RowBox[{"NewScalars", "[", 
              RowBox[{"[", 
               RowBox[{"particle", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "]"}], "]"}]}],
            "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"particle", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], "==", "\"\<V\>\""}], ",", 
            RowBox[{"Return", "[", 
             RowBox[{"NewVectors", "[", 
              RowBox[{"[", 
               RowBox[{"particle", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "]"}], "]"}]}],
            "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"particle", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], "==", "\"\<F\>\""}], ",", 
            RowBox[{"Return", "[", 
             RowBox[{"NewFermions", "[", 
              RowBox[{"[", 
               RowBox[{"particle", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "]"}], "]"}]}],
            "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"particle", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], "==", "\"\<Sc\>\""}], ",", 
            RowBox[{"Return", "[", 
             RowBox[{"FlattenAt", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"NewScalars", "[", 
                   RowBox[{"[", 
                    RowBox[{"particle", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "]"}], "[", 
                  
                  RowBox[{"[", "1", "]"}], "]"}], ",", 
                 RowBox[{"ConjugateRep", "[", 
                  RowBox[{
                   RowBox[{"NewScalars", "[", 
                    RowBox[{"[", 
                    RowBox[{"particle", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "]"}], "[", 
                   
                   RowBox[{"[", 
                    RowBox[{"2", ";;", "4"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
               RowBox[{"-", "1"}]}], "]"}], "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"particle", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], "==", "\"\<Vc\>\""}], ",", 
            RowBox[{"Return", "[", 
             RowBox[{"FlattenAt", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"NewVectors", "[", 
                   RowBox[{"[", 
                    RowBox[{"particle", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "]"}], "[", 
                  
                  RowBox[{"[", "1", "]"}], "]"}], ",", 
                 RowBox[{"ConjugateRep", "[", 
                  RowBox[{
                   RowBox[{"NewVectors", "[", 
                    RowBox[{"[", 
                    RowBox[{"particle", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "]"}], "[", 
                   
                   RowBox[{"[", 
                    RowBox[{"2", ";;", "4"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
               RowBox[{"-", "1"}]}], "]"}], "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"particle", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], "==", "\"\<Fc\>\""}], ",", 
            RowBox[{"Return", "[", 
             RowBox[{"FlattenAt", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"NewFermions", "[", 
                   RowBox[{"[", 
                    RowBox[{"particle", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "]"}], "[", 
                  
                  RowBox[{"[", "1", "]"}], "]"}], ",", 
                 RowBox[{"ConjugateRep", "[", 
                  RowBox[{
                   RowBox[{"NewFermions", "[", 
                    RowBox[{"[", 
                    RowBox[{"particle", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "]"}], "[", 
                   
                   RowBox[{"[", 
                    RowBox[{"2", ";;", "4"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
               RowBox[{"-", "1"}]}], "]"}], "]"}]}], "]"}], ";"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"Return", "[", "x", "]"}]}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GetParticleName", "[", "particleRep_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"DropChirality", ",", "particle", ",", "name"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"DropChirality", "[", "expr_", "]"}], ":=", 
       RowBox[{"expr", " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
            RowBox[{"Scalar", " ", 
             RowBox[{"(", "S", ")"}]}], ":", 
            RowBox[{"{", "0", "}"}]}], ",", 
           RowBox[{"{", "0", "}"}]}], "*)"}], 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "0", "}"}], ",", " ", 
             RowBox[{"{", "0", "}"}], ",", " ", "rest___"}], "}"}], " ", ":>",
            " ", 
           RowBox[{"{", 
            RowBox[{"\"\<S\>\"", ",", "rest"}], "}"}]}], ",", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
             RowBox[{"Fermion", " ", 
              RowBox[{"(", "F", ")"}]}], ":", 
             RowBox[{"{", "0", "}"}]}], ",", 
            RowBox[{
             RowBox[{"{", "1", "}"}], " ", "or", " ", 
             RowBox[{"{", "1", "}"}]}], ",", 
            RowBox[{"{", "0", "}"}]}], "*)"}], 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "0", "}"}], ",", " ", 
             RowBox[{"{", "1", "}"}], ",", "rest___"}], "}"}], " ", ":>", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<F\>\"", ",", " ", "rest"}], "}"}]}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "1", "}"}], ",", " ", 
             RowBox[{"{", "0", "}"}], ",", " ", "rest___"}], "}"}], " ", ":>",
            " ", 
           RowBox[{"{", 
            RowBox[{"\"\<F\>\"", ",", "rest"}], "}"}]}], ",", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
             RowBox[{"Vector", " ", 
              RowBox[{"(", "V", ")"}]}], ":", 
             RowBox[{"{", "1", "}"}]}], ",", 
            RowBox[{"{", "1", "}"}]}], "*)"}], 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "1", "}"}], ",", " ", 
             RowBox[{"{", "1", "}"}], ",", " ", "rest___"}], "}"}], " ", ":>",
            " ", 
           RowBox[{"{", 
            RowBox[{"\"\<V\>\"", ",", " ", "rest"}], "}"}]}]}], "}"}]}]}], 
      ";"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
        RowBox[{
        "if", " ", "representation", " ", "is", " ", "of", " ", "the", " ", 
         "form", " ", 
         FormBox[
          RowBox[{
           SubscriptBox[
            RowBox[{"SU", "(", "2", ")"}], "left"], 
           SubscriptBox[
            RowBox[{"xSU", "(", "2", ")"}], "right"], "x", 
           SubscriptBox[
            RowBox[{"SU", "(", "3", ")"}], "color"], 
           SubscriptBox[
            RowBox[{"xSU", "(", "2", ")"}], "L"], "xU", 
           SubscriptBox[
            RowBox[{"(", "1", ")"}], "Y"]}],
          TraditionalForm], " ", "we", " ", "convert", " ", "to", " ", 
         "chirality"}], "-", 
        RowBox[{"blind", " ", "output"}]}], ",", " ", 
       RowBox[{"e", ".", "g", ".", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<F\>\"", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", "1", "}"}], ",", 
          RowBox[{"1", "/", "2"}]}], "}"}]}]}], "*)"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Which", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "particleRep", "]"}], "==", "5"}], ",", 
       RowBox[{"particle", "=", 
        RowBox[{"DropChirality", "[", 
         RowBox[{"RepNaming", "[", "particleRep", "]"}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "particleRep", "]"}], "==", "4"}], "&&", 
        RowBox[{"StringQ", "[", 
         RowBox[{"particleRep", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", 
       RowBox[{"particle", "=", 
        RowBox[{"RepNaming", "[", "particleRep", "]"}]}], ",", 
       "\[IndentingNewLine]", "True", ",", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<unknown rep format\>\"", "]"}], ";", 
        RowBox[{"Return", "[", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Which", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"particle", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "==", "\"\<S\>\""}], ",", 
       RowBox[{"name", "=", 
        RowBox[{"StringJoin", "[", 
         RowBox[{"\"\<S[\>\"", ",", 
          RowBox[{"ToString", "[", 
           RowBox[{
            RowBox[{"FirstPosition", "[", 
             RowBox[{"NewScalars", ",", "particle"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", "\"\<]\>\""}], 
         "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"particle", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "==", "\"\<F\>\""}], ",", 
       RowBox[{"name", "=", 
        RowBox[{"StringJoin", "[", 
         RowBox[{"\"\<F[\>\"", ",", 
          RowBox[{"ToString", "[", 
           RowBox[{
            RowBox[{"FirstPosition", "[", 
             RowBox[{"NewFermions", ",", "particle"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", "\"\<]\>\""}], 
         "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"particle", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "==", "\"\<V\>\""}], ",", 
       RowBox[{"name", "=", 
        RowBox[{"StringJoin", "[", 
         RowBox[{"\"\<V[\>\"", ",", 
          RowBox[{"ToString", "[", 
           RowBox[{
            RowBox[{"FirstPosition", "[", 
             RowBox[{"NewVectors", ",", "particle"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", "\"\<]\>\""}], 
         "]"}]}], ",", "\[IndentingNewLine]", "True", ",", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<unknown rep format\>\"", "]"}], ";", 
        RowBox[{"Return", "[", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"name", "==", "\"\<S[NotFound]\>\""}], "||", 
        RowBox[{"name", "==", "\"\<F[NotFound]\>\""}], "||", 
        RowBox[{"name", "==", "\"\<V[NotFound]\>\""}]}], ",", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<particle not in list\>\"", "]"}], ";", 
        RowBox[{"Return", "[", "]"}], ";"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"RepNaming", "[", "particleRep", "]"}], "==", "particleRep"}],
        ",", 
       RowBox[{"Return", "[", "name", "]"}], ",", 
       RowBox[{
        RowBox[{"RepNaming", "[", "particleRep", "]"}], "==", 
        RowBox[{"ConjugateRep", "[", "particleRep", "]"}]}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"ConjugateRep", "[", "name", "]"}], "]"}], ",", "True", 
       ",", "\"\<unknown rep\>\""}], "]"}], ";"}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
