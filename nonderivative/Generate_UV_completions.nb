Cell[CellGroupData[{

Cell["Importing our UV files", "Section",
 CellChangeTimes->{{3.972490338394877*^9, 
  3.972490344190001*^9}},ExpressionUUID->"964b6530-a09f-4637-bb63-\
13f489177899"],

Cell["\<\
Download the UV completions from https://julian-heeck.github.io/BNV/ and \
simply import whichever case you\[CloseCurlyQuote]re interested in. The UV \
completions are sorted into folders of mass dimension, and amount of baryon \
and lepton number violation. For example, UV_Dim8_1B_1L contains all UV \
completions for d=8 operators with B=1 and L=1. Inside each folder, one finds \
.wl files of a certain topology-operator combination, e.g. \
UV_Dim8_1B_1L_T3_O7.wl, which contains UV completions for topology 3 and \
operator 7. Each file looks something like this:\
\>", "Text",
 CellChangeTimes->{{3.972493101219885*^9, 3.972493210768861*^9}, {
   3.972493700754936*^9, 3.972493710008424*^9}, {3.973417616015081*^9, 
   3.973417618125606*^9}, 3.973862573515711*^9, {3.984314005617186*^9, 
   3.98431412916842*^9}, {4.004011754713251*^9, 
   4.004011769836567*^9}},ExpressionUUID->"99f410a3-9aa8-4d82-ab11-\
fcff8753cba5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"import", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       GraphicsBox[
        NamespaceBox["NetworkGraphics",
         DynamicModuleBox[{Typeset`graph = HoldComplete[
           
           Graph[{"a", "b", "c", "d", "e", "f", "g", "h", "i", "j"}, {
            Null, {{1, 2}, {3, 4}, {5, 2}, {6, 4}, {7, 8}, {9, 8}, {2, 10}, {
             4, 10}, {8, 10}}}, {
            EdgeLabels -> {UndirectedEdge["i", "h"] -> Placed[
                 Text["6", Background -> GrayLevel[1]], {Left, "Middle"}], 
               UndirectedEdge["b", "j"] -> Placed[
                 Text["7", Background -> GrayLevel[1]], {Left, "Middle"}], 
               UndirectedEdge["e", "b"] -> Placed[
                 Text["3", Background -> GrayLevel[1]], {Left, "Middle"}], 
               UndirectedEdge["f", "d"] -> Placed[
                 Text["4", Background -> GrayLevel[1]], {Left, "Middle"}], 
               UndirectedEdge["c", "d"] -> Placed[
                 Text["2", Background -> GrayLevel[1]], {Left, "Middle"}], 
               UndirectedEdge["a", "b"] -> Placed[
                 Text["1", Background -> GrayLevel[1]], {Left, "Middle"}], 
               UndirectedEdge["g", "h"] -> Placed[
                 Text["5", Background -> GrayLevel[1]], {Left, "Middle"}], 
               UndirectedEdge["d", "j"] -> Placed[
                 Text["8", Background -> GrayLevel[1]], {Left, "Middle"}], 
               UndirectedEdge["h", "j"] -> Placed[
                 Text["9", Background -> GrayLevel[1]], {Left, "Middle"}]}, 
             EdgeStyle -> {UndirectedEdge["h", "j"] -> {
                 RGBColor[1, 0, 0], 
                 Dashing[{Small, Small}]}, UndirectedEdge["e", "b"] -> 
               GrayLevel[0], UndirectedEdge["d", "j"] -> RGBColor[1, 0, 0], 
               UndirectedEdge["c", "d"] -> {
