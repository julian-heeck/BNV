Cell["\<\
Sometimes it is useful to read off the operator from the UV completion and \
then collect its properties, namely baryon number B, lepton number L, mass \
dimension d, number of fermions F, and number of scalars S:\
\>", "Text",
 CellChangeTimes->{{3.972494184517016*^9, 
  3.972494255701283*^9}},ExpressionUUID->"7e7d1e81-0ae6-445d-af3f-\
becb33a693c7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"takes", " ", "an", " ", "operator", " ", "like", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Q\>\"", ",", "\"\<Q\>\"", ",", "\"\<Q\>\"", 
        ",", "\"\<L\>\""}], "}"}], " ", "and", " ", "returns", " ", "a", " ", 
      "list", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"baryon", " ", "number"}], ",", " ", 
        RowBox[{"lepton", " ", "number"}], ",", " ", 
        RowBox[{"operator", " ", "dimension"}], ",", " ", 
        RowBox[{"number", " ", "of", " ", "fermions"}], ",", " ", 
        RowBox[{"number", " ", "of", " ", "scalars"}]}], "}"}]}], ",", " ", 
     RowBox[{
      RowBox[{"e", ".", "g", ".", " ", 
       RowBox[{"BLd", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<Q\>\"", ",", "\"\<Q\>\"", ",", "\"\<Q\>\"", 
          ",", "\"\<L\>\""}], "}"}], "]"}]}], " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "6", ",", "4", ",", "0"}], "}"}]}]}], 
    "}"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"BLdFS", "[", "operator_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "baryons", ",", "antibaryons", ",", "leptons", ",", "antileptons", ",", 
       "scalars"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"baryons", "=", 
       RowBox[{
        RowBox[{"Count", "[", 
         RowBox[{"operator", ",", "\"\<Q\>\""}], "]"}], "+", 
        RowBox[{"Count", "[", 
         RowBox[{"operator", ",", "\"\<uR\>\""}], "]"}], "+", 
        RowBox[{"Count", "[", 
         RowBox[{"operator", ",", "\"\<dR\>\""}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"antibaryons", "=", 
       RowBox[{
        RowBox[{"Count", "[", 
         RowBox[{"operator", ",", "\"\<Qc\>\""}], "]"}], "+", 
        RowBox[{"Count", "[", 
         RowBox[{"operator", ",", "\"\<uc\>\""}], "]"}], "+", 
        RowBox[{"Count", "[", 
         RowBox[{"operator", ",", "\"\<dc\>\""}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"leptons", "=", 
       RowBox[{
        RowBox[{"Count", "[", 
         RowBox[{"operator", ",", "\"\<L\>\""}], "]"}], "+", 
        RowBox[{"Count", "[", 
         RowBox[{"operator", ",", "\"\<eR\>\""}], "]"}], "+", 
        RowBox[{"Count", "[", 
         RowBox[{"operator", ",", "\"\<NR\>\""}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"antileptons", "=", 
       RowBox[{
        RowBox[{"Count", "[", 
         RowBox[{"operator", ",", "\"\<Lc\>\""}], "]"}], "+", 
        RowBox[{"Count", "[", 
         RowBox[{"operator", ",", "\"\<ec\>\""}], "]"}], "+", 
        RowBox[{"Count", "[", 
         RowBox[{"operator", ",", "\"\<Nc\>\""}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"scalars", "=", 
       RowBox[{
        RowBox[{"Count", "[", 
         RowBox[{"operator", ",", "\"\<H\>\""}], "]"}], "+", 
        RowBox[{"Count", "[", 
         RowBox[{"operator", ",", "\"\<Hc\>\""}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "operator", "]"}], "!=", 
         RowBox[{"(", 
          RowBox[{
          "baryons", "+", "antibaryons", "+", "leptons", "+", "antileptons", "+",
            "scalars"}], ")"}]}], ",", 
        RowBox[{
        "Print", "[", "\"\<unexpected fields in operator\>\"", "]"}]}], "]"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         FractionBox["1", "3"], 
         RowBox[{"(", 
          RowBox[{"baryons", "-", "antibaryons"}], ")"}]}], ",", 
        RowBox[{"(", 
         RowBox[{"leptons", "-", "antileptons"}], ")"}], ",", 
        RowBox[{
         RowBox[{
          FractionBox["3", "2"], 
          RowBox[{"(", 
           RowBox[{
           "baryons", "+", "antibaryons", "+", "leptons", "+", 
            "antileptons"}], ")"}]}], "+", "scalars"}], ",", 
        RowBox[{
        "baryons", "+", "antibaryons", "+", "leptons", "+", "antileptons"}], ",",
         "scalars"}], "}"}]}]}], "\[IndentingNewLine]", "]"}]}]}]], "Input",
