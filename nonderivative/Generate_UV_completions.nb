          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"Invariants", "[", 
             RowBox[{"group", ",", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"particles", "[", 
                  RowBox[{"[", 
                   RowBox[{"topology", "[", 
                    RowBox[{"[", 
