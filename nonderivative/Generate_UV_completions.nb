Cell[TextData[{
 "The list is redundant in the sense that  ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\<\"Q\"\>", ",", "\<\"Q\"\>", ",", "\<\"Q\"\>", ",", "\<\"L\"\>", 
    ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "0", "}"}], ",", 
      RowBox[{"{", "0", "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", "2", "}"}], ",", 
      FractionBox["1", "3"]}], "}"}]}], "}"}]], "Output",
  CellChangeTimes->{
   3.936194351806369*^9, {3.936194397983707*^9, 3.936194415540875*^9}, 
    3.936194486076464*^9, {3.936194702807621*^9, 3.936194740742436*^9}, 
    3.936194804948459*^9, 3.936196139001511*^9, 3.959761432869382*^9, 
    3.972039601804873*^9, 3.972050007399661*^9, 3.972126922703293*^9, 
    3.972127007974421*^9, {3.9721275415896482`*^9, 3.9721275867821827`*^9}, {
    3.972127620508388*^9, 3.972127628841394*^9}},ExpressionUUID->
  "219f0b59-bf3a-449e-987f-7084feb377f0"],
 " and  ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\<\"Q\"\>", ",", "\<\"L\"\>", ",", "\<\"Q\"\>", ",", "\<\"Q\"\>", 
    ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "0", "}"}], ",", 
      RowBox[{"{", "0", "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", "2", "}"}], ",", 
      RowBox[{"-", 
       FractionBox["1", "3"]}]}], "}"}]}], "}"}]], "Output",
  CellChangeTimes->{
   3.936194351806369*^9, {3.936194397983707*^9, 3.936194415540875*^9}, 
    3.936194486076464*^9, {3.936194702807621*^9, 3.936194740742436*^9}, 
    3.936194804948459*^9, 3.936196139001511*^9, 3.959761432869382*^9, 
    3.972039601804873*^9, 3.972050007399661*^9, 3.972126922703293*^9, 
    3.972127007974421*^9, {3.9721275415896482`*^9, 3.9721275867821827`*^9}, {
    3.972127620508388*^9, 3.972127628841394*^9}},ExpressionUUID->
  "1f460c58-1add-4353-bcfc-30b73b330c9b"],
 " are actually the same solution, just with a different momentum routing on \
the internal line. Also, exchanging particles 1 and 2 or 3 and 4 obviously \
give the same representation for particle 5, but show up as different entries \
above. The next step is then to remove equivalent UV completions."
}], "Text",
 CellChangeTimes->{{3.9720398160724173`*^9, 3.9720398939856443`*^9}, 
   3.972040037740233*^9, {3.97212781784828*^9, 
   3.9721278622462883`*^9}},ExpressionUUID->"533f1520-a02c-4eec-ac3e-\
d8af78b17e38"]
}, Closed]],

Cell[CellGroupData[{

Cell["Equivalence of UV completions", "Section",
 CellChangeTimes->{{3.972040054148088*^9, 
  3.972040059611788*^9}},ExpressionUUID->"4f6625a0-8b73-4012-be89-\
5bb20504d6c1"],

Cell["\<\
To determine if two UV completions are equivalent, we turn our Feynman \
diagram into a directed graph via the function MomentumGraph (see \
Generate_topologies notebook) to incorporate the information about momentum \
flow. Then, we change all internal anti-particles (as determined by our \
RepNaming function) to particles and flip the momentum arrow via the function \
FullParticleDiagram, which generates a canonical graph. This requires several \
functions from Generate_topologies:\
\>", "Text",
 CellChangeTimes->{{3.972128107157393*^9, 3.97212827753513*^9}, 
   3.972128657378899*^9, {3.9721289804736032`*^9, 3.972129009387282*^9}, {
   3.9721290630591288`*^9, 3.972129068624333*^9}, {3.972129434446006*^9, 
   3.972129441098707*^9}, {3.972129832057993*^9, 3.972129843050255*^9}, {
   3.9721300601967363`*^9, 
   3.972130110261983*^9}},ExpressionUUID->"3388de13-5aa4-49a9-b8f5-\
9b394b0c8822"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"MakeDirectedGraph", "[", "g_Graph", "]"}], " ", ":=", 
   RowBox[{"Graph", "[", 
    RowBox[{
     RowBox[{"DirectedEdge", "@@@", 
      RowBox[{"EdgeList", "[", "g", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"EdgeLabels", "->", 
         RowBox[{"(", 
          RowBox[{"EdgeLabels", "/.", " ", 
           RowBox[{"Options", "[", 
            RowBox[{"g", ",", "EdgeLabels"}], "]"}]}], ")"}]}], "/.", " ", 
        RowBox[{
         RowBox[{"Rule", "[", 
          RowBox[{
           RowBox[{"UndirectedEdge", "[", 
            RowBox[{"a_", ",", "b_"}], "]"}], ",", "val_"}], "]"}], ":>", 
         RowBox[{"Rule", "[", 
          RowBox[{
           RowBox[{"DirectedEdge", "[", 
            RowBox[{"a", ",", "b"}], "]"}], ",", "val"}], "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"EdgeStyle", "->", 
         RowBox[{"(", 
          RowBox[{"EdgeStyle", "/.", " ", 
           RowBox[{"Options", "[", 
            RowBox[{"g", ",", "EdgeStyle"}], "]"}]}], ")"}]}], "/.", " ", 
        RowBox[{
         RowBox[{"Rule", "[", 
          RowBox[{
           RowBox[{"UndirectedEdge", "[", 
            RowBox[{"a_", ",", "b_"}], "]"}], ",", "val_"}], "]"}], ":>", 
         RowBox[{"Rule", "[", 
          RowBox[{
           RowBox[{"DirectedEdge", "[", 
            RowBox[{"a", ",", "b"}], "]"}], ",", "val"}], "]"}]}]}]}], 
      "}"}]}], "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"FlipEdgeByLabel", "[", 
    RowBox[{"g_Graph", ",", "labelText_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "edges", ",", "labelsRaw", ",", "stylesRaw", ",", "labelsList", ",", 
       "stylesList", ",", "targetPairs", ",", "keys", ",", "revKeys", ",", 
       "mapping", ",", "newEdges", ",", "newLabels", ",", "newStyles", ",", 
       "otherOpts", ",", "extractText", ",", "canon"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{"helper", ":", 
       RowBox[{
       "extract", " ", "visible", " ", "text", " ", "from", " ", "label", " ",
         "objects"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"extractText", "[", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Text", "[", 
             RowBox[{"x_", ",", "___"}], "]"}], ",", "___"}], "]"}], ",", 
          "___"}], "]"}], "]"}], ":=", "x"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"extractText", "[", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"Text", "[", 
           RowBox[{"x_", ",", "___"}], "]"}], ",", "___"}], "]"}], "]"}], ":=",
        "x"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"extractText", "[", 
        RowBox[{"Text", "[", 
         RowBox[{"x_", ",", "___"}], "]"}], "]"}], ":=", "x"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"extractText", "[", "x_", "]"}], ":=", "x"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"canonicalize", " ", "label", " ", "for", " ", "matching", " ", 
        RowBox[{"(", 
         RowBox[{
         "so", " ", "5", " ", "and", " ", "\"\<5\>\"", " ", "compare", " ", 
          "equal"}], ")"}]}], "*)"}], 
      RowBox[{
       RowBox[{"canon", "[", "x_", "]"}], ":=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"StringQ", "[", "x", "]"}], ",", "x", ",", 
         RowBox[{"ToString", "[", 
          RowBox[{"x", ",", "InputForm"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"1", ")"}], " ", "get", " ", "edge", " ", "list", " ", "and", 
        " ", "existing", " ", 
        RowBox[{"label", "/", "style"}], " ", "rules", " ", 
        RowBox[{"(", 
