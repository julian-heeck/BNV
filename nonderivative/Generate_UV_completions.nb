Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "replace", " ", "SM", " ", "particle", " ", "quantum", " ", "numbers", " ",
     "by", " ", "their", " ", "names", " ", "for", " ", "display", " ", 
    RowBox[{"purposes", ":"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ReplaceSMnames", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Q", "->", "\"\<Q\>\""}], ",", 
       RowBox[{"L", "->", "\"\<L\>\""}], ",", 
       RowBox[{"uR", "->", "\"\<uR\>\""}], ",", 
       RowBox[{"dR", "->", "\"\<dR\>\""}], ",", 
       RowBox[{"eR", "->", "\"\<eR\>\""}], ",", 
       RowBox[{"NR", "->", "\"\<NR\>\""}], ",", 
       RowBox[{"Qc", "->", "\"\<Qc\>\""}], ",", 
       RowBox[{"Lc", "->", "\"\<Lc\>\""}], ",", 
       RowBox[{"uc", "->", "\"\<uc\>\""}], ",", 
       RowBox[{"dc", "->", "\"\<dc\>\""}], ",", 
       RowBox[{"ec", "->", "\"\<ec\>\""}], ",", 
       RowBox[{"Nc", "->", "\"\<Nc\>\""}], ",", 
       RowBox[{"H", "->", "\"\<H\>\""}], ",", 
       RowBox[{"Hc", "->", "\"\<Hc\>\""}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"InverseReplaceSMnames", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<Q\>\"", "->", "Q"}], ",", 
       RowBox[{"\"\<L\>\"", "->", "L"}], ",", 
       RowBox[{"\"\<uR\>\"", "->", "uR"}], ",", 
       RowBox[{"\"\<dR\>\"", "->", "dR"}], ",", 
       RowBox[{"\"\<eR\>\"", "->", "eR"}], ",", 
       RowBox[{"\"\<NR\>\"", "->", "NR"}], ",", 
       RowBox[{"\"\<Qc\>\"", "->", "Qc"}], ",", 
       RowBox[{"\"\<Lc\>\"", "->", "Lc"}], ",", 
       RowBox[{"\"\<uc\>\"", "->", "uc"}], ",", 
       RowBox[{"\"\<dc\>\"", "->", "dc"}], ",", 
       RowBox[{"\"\<ec\>\"", "->", "ec"}], ",", 
       RowBox[{"\"\<Nc\>\"", "->", "Nc"}], ",", 
       RowBox[{"\"\<H\>\"", "->", "H"}], ",", 
       RowBox[{"\"\<Hc\>\"", "->", "Hc"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "function", " ", "that", " ", "checks", " ", "if", " ", "a", " ", 
      "product", " ", "of", " ", "representations"}], ",", " ", 
     RowBox[{
      RowBox[{"e", ".", "g", ".", " ", "an"}], " ", "operator", " ", "or", " ",
       "vertex"}], ",", " ", 
     RowBox[{"contains", " ", "a", " ", "singlet"}], ",", " ", 
     RowBox[{
      RowBox[{"e", ".", "g", ".", " ", 
       RowBox[{"ContainsSinglet", "[", 
        RowBox[{"{", 
         RowBox[{"H", ",", "Hc"}], "}"}], "]"}]}], " ", "=", " ", "True"}], ",",
      " ", 
     RowBox[{
      RowBox[{"ContainsSinglet", "[", 
       RowBox[{"{", 
        RowBox[{"Lc", ",", "L"}], "}"}], "]"}], " ", "=", " ", "False"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ContainsSinglet", "[", "reps_", "]"}], ":=", 
    RowBox[{"MemberQ", "[", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Drop", "[", 
         RowBox[{
          RowBox[{"ReduceRepProduct", "[", 
           RowBox[{"group", ",", "reps", ",", 
            RowBox[{"UseName", "\[Rule]", "False"}]}], "]"}], ",", "None", ",", 
          RowBox[{"-", "1"}]}], "]"}], ",", "1"}], "]"}], ",", "singlet"}], 
     "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
      "function", " ", "that", " ", "multiplies", " ", "representations", " ",
        "and", " ", "throws", " ", "away", " ", "multiplicities", " ", "and", 
       " ", "all", " ", "terms", " ", "with", " ", "spin"}], " ", ">", " ", 
      "1"}], ",", " ", 
     RowBox[{
      RowBox[{"e", ".", "g", ".", "  ", 
       RowBox[{"MyReduceRepProduct", "[", 
        RowBox[{"{", 
         RowBox[{"Lc", ",", "H", ",", "eR"}], "}"}], "]"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", "0", "}"}], ",", 
            RowBox[{"{", "0", "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", "2", "}"}], ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", "0", "}"}], ",", 
            RowBox[{"{", "0", "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", "0", "}"}], ",", "0"}], "}"}]}], "}"}], ".", " ", 
        "This"}], " ", "will", " ", "determine", " ", "the", " ", 
       "representations", " ", "of", " ", "internal", " ", "particles", " ", 
       "at", " ", "each", " ", 
       RowBox[{"vertex", ".", " ", "\[IndentingNewLine]", "To"}], " ", "also",
        " ", "throw", " ", "away", " ", "internal", " ", "vector", " ", 
       "particles"}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"just", " ", "change", " ", "1"}], "<", 
       RowBox[{"x", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "||", 
      RowBox[{"1", "<", 
       RowBox[{
        RowBox[{"x", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "1"}], "]"}], "]"}], " ", "to", " ", "1"}], "<", 
       RowBox[{"x", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "||", 
      RowBox[{"1", "<", 
       RowBox[{"x", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "1"}], "]"}], "]"}]}], "||", 
      RowBox[{"1", "<", 
       RowBox[{
        RowBox[{"x", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}], "+", 
        RowBox[{"x", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "1"}], "]"}], "]"}]}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MyReduceRepProduct", "[", "reps_", "]"}], ":=", 
    RowBox[{"DeleteCases", "[", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Drop", "[", 
         RowBox[{
          RowBox[{"ReduceRepProduct", "[", 
           RowBox[{"group", ",", "reps", ",", 
            RowBox[{"UseName", "\[Rule]", "False"}]}], "]"}], ",", "None", ",", 
          RowBox[{"-", "1"}]}], "]"}], ",", "1"}], "]"}], ",", 
      RowBox[{"x_", "/;", 
       RowBox[{
        RowBox[{"1", "<", 
         RowBox[{"x", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "||", 
        RowBox[{"1", "<", 
         RowBox[{"x", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "1"}], "]"}], "]"}]}]}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"takes", " ", "a", " ", "list", " ", "of", " ", "particles"}], ",",
      " ", 
     RowBox[{
      RowBox[{"i", ".", "e", ".", " ", 
       RowBox[{"an", " ", "'"}]}], 
      RowBox[{"operator", "'"}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "and", " ", "creates", " ", "all", " ", "permutations", " ", "so", " ", 
       "that", " ", "scalars", " ", "are", " ", "always", " ", "in", " ", 
       "the", " ", "first", " ", "slots"}], ";", " ", 
      RowBox[{"for", " ", "example"}]}], ",", " ", 
     RowBox[{
      RowBox[{"MyPermutations", "[", 
       RowBox[{"{", 
        RowBox[{"H", ",", "L", ",", "H", ",", "L"}], "}"}], "]"}], " ", 
      "just", " ", "gives", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"H", ",", "H", ",", "L", ",", "L"}], "}"}], "}"}]}], ",", " ", 
     RowBox[{"but", " ", 
      RowBox[{"MyPermutations", "[", 
       RowBox[{"{", 
        RowBox[{"L", ",", "Q", ",", "H"}], "}"}], "]"}], " ", "gives", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"H", ",", "L", ",", "Q"}], "}"}], ",", 
