    RowBox[{"[", "1", "]"}], "]"}]], "//", "Simplify"}]], "Input",
 CellChangeTimes->{{3.972488234549903*^9, 3.9724883879181337`*^9}},
 CellLabel->"In[88]:=",ExpressionUUID->"77d1b64a-fd5a-47af-b7ec-7f4ad212a414"],

