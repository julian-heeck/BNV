 RowBox[{
  RowBox[{"amp", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"amplitude", "[", "example", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"p1", "->", "a"}], ",", 
       RowBox[{"p2", "->", "b"}], ",", 
       RowBox[{"p3", "->", "c"}], ",", 
       RowBox[{"p4", "->", "d"}], ",", 
       RowBox[{"p5", "->", "e"}], ",", 
       RowBox[{"p6", "->", "f"}], ",", 
       RowBox[{"p7", "->", "g"}], ",", 
       RowBox[{"p8", "->", "h"}]}], "}"}]}], "//", "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"inv", "=", 
   RowBox[{
    RowBox[{"Invariants", "[", 
     RowBox[{"group", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"example", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", 
          RowBox[{"Count", "[", 
           RowBox[{
            RowBox[{"VertexDegree", "[", 
             RowBox[{"example", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], ",", "1"}], 
           "]"}]}], "]"}], "]"}], "/.", "InverseReplaceSMnames"}]}], "]"}], "//",
     "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coeffs", "=", 
   RowBox[{"Array", "[", 
    RowBox[{"x", ",", 
     RowBox[{"Length", "[", "inv", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lincomb", "=", 
   RowBox[{"coeffs", ".", "inv"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"states", "=", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Values", "[", 
      RowBox[{"GroupBy", "[", 
       RowBox[{
        RowBox[{"DeleteDuplicates", "[", 
         RowBox[{"Cases", "[", 
          RowBox[{"inv", ",", 
           RowBox[{"Alternatives", "@@", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", "___", "]"}], "&"}], "/@", 
              RowBox[{"{", 
               RowBox[{
               "a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f", ",", 
                "g", ",", "h"}], "}"}]}], ")"}]}], ",", "All"}], "]"}], "]"}],
         ",", "Head"}], "]"}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"sol", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"0", "==", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"amp", "-", "lincomb"}], ")"}], "/.", 
         RowBox[{"Thread", "[", 
          RowBox[{"states", " ", "->", " ", 
           RowBox[{"Rationalize", "[", 
            RowBox[{
             RowBox[{"RandomReal", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
               RowBox[{"Length", "[", "states", "]"}]}], "]"}], ",", 
             RowBox[{"1", "/", "100"}]}], "]"}]}], "]"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", 
        RowBox[{"Length", "[", "coeffs", "]"}]}], "}"}]}], "]"}], ",", 
    "coeffs", ",", "Reals"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"amp", "-", "lincomb"}], ")"}], "/.", 
      RowBox[{"sol", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "==", "0"}], ",", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Our UV completion = \>\"", ",", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"x", "[", "j", "]"}], "/.", 
          RowBox[{"sol", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ")"}], 
        RowBox[{"\"\<Inv\>\"", "[", "j", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", 
         RowBox[{"Length", "[", "coeffs", "]"}]}], "}"}]}], "]"}]}], "]"}], ",", 
   RowBox[{
   "Print", "[", "\"\<Can't find linear combintion of invariants that match \
our amplitude.\>\"", "]"}]}], "]"}]}], "Input",
