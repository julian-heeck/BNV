Cell[CellGroupData[{

Cell["Determining the internal quantum numbers", "Section",
 CellChangeTimes->{{3.972035534976411*^9, 3.972035539704393*^9}, {
  3.972035950309022*^9, 
  3.972035951492715*^9}},ExpressionUUID->"1dd6b744-7c3f-4a0a-a8fd-\
3528ad4e8223"],

Cell[TextData[{
 "This function takes a topology and an operator with matching number of \
external bosons and fermions, e.g. the d=11 eight-particle operator \
{H,H,Lc,Lc,dR,dR,dR,eR}. Notice that the operators have to be sorted so that \
scalars are first, so {scalar1, scalar2,...., fermion1,fermion2,...}.\nOur \
topologies have the form (see Generate_topologies notebook)\n",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    GraphicsBox[
     NamespaceBox["NetworkGraphics",
      DynamicModuleBox[{Typeset`graph = HoldComplete[
        Graph[{
         "a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m"}, {
         Null, {{1, 2}, {3, 2}, {4, 5}, {6, 5}, {7, 8}, {9, 8}, {10, 11}, {12,
           11}, {13, 2}, {13, 5}, {13, 8}, {13, 11}}}, {
         EdgeLabels -> {UndirectedEdge["i", "h"] -> Placed[
              Text["6", Background -> GrayLevel[1]], {Left, "Middle"}], 
            UndirectedEdge["l", "k"] -> Placed[
              Text["8", Background -> GrayLevel[1]], {Left, "Middle"}], 
            UndirectedEdge["m", "b"] -> Placed[
              Text["9", Background -> GrayLevel[1]], {Left, "Middle"}], 
            UndirectedEdge["m", "e"] -> Placed[
              Text["10", Background -> GrayLevel[1]], {Left, "Middle"}], 
            UndirectedEdge["c", "b"] -> Placed[
              Text["2", Background -> GrayLevel[1]], {Left, "Middle"}], 
            UndirectedEdge["d", "e"] -> Placed[
              Text["3", Background -> GrayLevel[1]], {Left, "Middle"}], 
            UndirectedEdge["f", "e"] -> Placed[
              Text["4", Background -> GrayLevel[1]], {Left, "Middle"}], 
            UndirectedEdge["a", "b"] -> Placed[
              Text["1", Background -> GrayLevel[1]], {Left, "Middle"}], 
            UndirectedEdge["g", "h"] -> Placed[
              Text["5", Background -> GrayLevel[1]], {Left, "Middle"}], 
            UndirectedEdge["m", "h"] -> Placed[
              Text["11", Background -> GrayLevel[1]], {Left, "Middle"}], 
            UndirectedEdge["m", "k"] -> Placed[
              Text["12", Background -> GrayLevel[1]], {Left, "Middle"}], 
            UndirectedEdge["j", "k"] -> Placed[
              Text["7", Background -> GrayLevel[1]], {Left, "Middle"}]}, 
          EdgeStyle -> {
           UndirectedEdge["l", "k"] -> GrayLevel[0], UndirectedEdge["d", "e"] -> 
            GrayLevel[0], UndirectedEdge["m", "k"] -> {
              RGBColor[1, 0, 0], 
              Dashing[{Small, Small}]}, UndirectedEdge["j", "k"] -> 
            GrayLevel[0], UndirectedEdge["m", "b"] -> {
              RGBColor[1, 0, 0], 
              Dashing[{Small, Small}]}, UndirectedEdge["m", "h"] -> {
              RGBColor[1, 0, 0], 
              Dashing[{Small, Small}]}, UndirectedEdge["g", "h"] -> 
            GrayLevel[0], UndirectedEdge["m", "e"] -> {
              RGBColor[1, 0, 0], 
              Dashing[{Small, Small}]}, UndirectedEdge["i", "h"] -> 
            GrayLevel[0], UndirectedEdge["f", "e"] -> GrayLevel[0], 
            UndirectedEdge["a", "b"] -> {
              GrayLevel[0], 
              Dashing[{Small, Small}]}, UndirectedEdge["c", "b"] -> {
              GrayLevel[0], 
              Dashing[{Small, Small}]}}, FormatType -> TraditionalForm}]]}, 
       TagBox[GraphicsGroupBox[{
          {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], {
            {GrayLevel[0], Dashing[{Small, Small}], 
             {Arrowheads[0.], 
              ArrowBox[{{0., 0.}, {0.2970442628930023, 0.5940885257860046}}, 
