Cell["\<\
Instead of the GroupMath operator basis one can also use others, e.g. the \
Warsaw basis for d=6 operators. \
\>", "Text",
 CellChangeTimes->{{3.972490245405039*^9, 
  3.972490326438033*^9}},ExpressionUUID->"a20e6937-7aa2-4f03-b937-\
4f4593b8d9b4"]
}, Closed]],

Cell[CellGroupData[{

Cell["Pretty diagrams", "Section",
 CellChangeTimes->{{3.973863701037705*^9, 
  3.973863707202436*^9}},ExpressionUUID->"7219d6bf-cb38-4f65-9e1c-\
4c4284ed0191"],

Cell["\<\
A function to display a UV completion in a fairly pretty way including the \
charge flow, dropping chirality for convenience. The graph is rotated to \
avoid overlapping labels, but this does not always solve the problem. Notice \
that the output is no longer a Graph object but just a graphic.\
\>", "Text",
 CellChangeTimes->{{3.9725063510561857`*^9, 3.9725064216171703`*^9}, {
  3.972506451660277*^9, 3.9725065150946083`*^9}, {3.972506568229951*^9, 
  3.97250658290028*^9}, {3.972506663799673*^9, 
  3.9725067086051598`*^9}},ExpressionUUID->"e18be7ab-0da1-4c27-853a-\
14c6d873429d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PrettyUVGraph", "[", "uvcompletion_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "DropChirality", ",", "transformListGeneral", ",", "fullgraph", ",", 
      "edgeLabels", ",", "newEdgeLabels"}], "}"}], ",", "\[IndentingNewLine]",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"DropChirality", "[", "expr_", "]"}], ":=", 
      RowBox[{"expr", " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
           RowBox[{"Scalar", " ", 
            RowBox[{"(", "S", ")"}]}], ":", 
           RowBox[{"{", "0", "}"}]}], ",", 
          RowBox[{"{", "0", "}"}]}], "*)"}], 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", "0", "}"}], ",", " ", 
            RowBox[{"{", "0", "}"}], ",", " ", "rest___"}], "}"}], " ", ":>", 
          " ", 
          RowBox[{"{", 
           RowBox[{"\"\<S\>\"", ",", "rest"}], "}"}]}], ",", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
            RowBox[{"Fermion", " ", 
             RowBox[{"(", "F", ")"}]}], ":", 
            RowBox[{"{", "0", "}"}]}], ",", 
           RowBox[{
            RowBox[{"{", "1", "}"}], " ", "or", " ", 
            RowBox[{"{", "1", "}"}]}], ",", 
           RowBox[{"{", "0", "}"}]}], "*)"}], 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", "0", "}"}], ",", " ", 
            RowBox[{"{", "1", "}"}], ",", "rest___"}], "}"}], " ", ":>", " ", 
          
          RowBox[{"{", 
           RowBox[{"\"\<F\>\"", ",", " ", "rest"}], "}"}]}], ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", "1", "}"}], ",", " ", 
            RowBox[{"{", "0", "}"}], ",", " ", "rest___"}], "}"}], " ", ":>", 
          " ", 
          RowBox[{"{", 
           RowBox[{"\"\<F\>\"", ",", "rest"}], "}"}]}], ",", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
            RowBox[{"Vector", " ", 
             RowBox[{"(", "V", ")"}]}], ":", 
            RowBox[{"{", "1", "}"}]}], ",", 
           RowBox[{"{", "1", "}"}]}], "*)"}], 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", "1", "}"}], ",", " ", 
            RowBox[{"{", "1", "}"}], ",", " ", "rest___"}], "}"}], " ", ":>", 
          " ", 
          RowBox[{"{", 
           RowBox[{"\"\<V\>\"", ",", " ", "rest"}], "}"}]}]}], "}"}]}]}], ";",
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"transformListGeneral", "[", "list_", "]"}], ":=", 
      RowBox[{"list", "/.", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"s_String", ",", "aa_", ",", "bb_", ",", "cc_"}], "}"}], ":>", 
        SubscriptBox["s", 
         RowBox[{"Replace", "[", 
          RowBox[{
           RowBox[{"RepName", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"SU3", ",", "SU2", ",", "U1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"aa", ",", "bb", ",", "cc"}], "}"}]}], "]"}], ",", 
           RowBox[{
            RowBox[{"CircleTimes", "[", 
             RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], ":>", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              
              RowBox[{"\"\<(\>\"", ",", "a", ",", "\"\<, \>\"", ",", "b", 
               ",", "\"\<, \>\"", ",", "c", ",", "\"\<)\>\""}], "}"}], 
             "]"}]}]}], "]"}]]}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"fullgraph", "=", 
      RowBox[{"FullParticleDiagram", "[", 
       RowBox[{"DropChirality", "[", 
        RowBox[{"uvcompletion", "/.", 
         RowBox[{"{", 
          RowBox[{
           
           RowBox[{"\"\<Q\>\"", 
            "->", "\"\<\!\(\*SubscriptBox[\(Q\), \(L\)]\)\>\""}], ",", 
           
           RowBox[{"\"\<L\>\"", 
            "->", "\"\<\!\(\*SubscriptBox[\(L\), \(L\)]\)\>\""}], ",", 
           
           RowBox[{"\"\<uR\>\"", 
            "->", "\"\<\!\(\*SubscriptBox[\(u\), \(R\)]\)\>\""}], ",", 
           
           RowBox[{"\"\<dR\>\"", 
            "->", "\"\<\!\(\*SubscriptBox[\(d\), \(R\)]\)\>\""}], ",", 
           
           RowBox[{"\"\<eR\>\"", 
            "->", "\"\<\!\(\*SubscriptBox[\(e\), \(R\)]\)\>\""}], ",", 
           
           RowBox[{"\"\<NR\>\"", 
            "->", "\"\<\!\(\*SubscriptBox[\(N\), \(R\)]\)\>\""}], ",", 
           
           RowBox[{"\"\<Qc\>\"", 
            "->", "\"\<\!\(\*SubscriptBox[OverscriptBox[\(Q\), \(_\)], \(L\)]\
\)\>\""}], ",", 
           
           RowBox[{"\"\<Lc\>\"", 
            "->", "\"\<\!\(\*SubscriptBox[OverscriptBox[\(L\), \(_\)], \(L\)]\
\)\>\""}], ",", 
           
           RowBox[{"\"\<uc\>\"", 
            "->", "\"\<\!\(\*SubscriptBox[OverscriptBox[\(u\), \(_\)], \(R\)]\
\)\>\""}], ",", 
           
           RowBox[{"\"\<dc\>\"", 
            "->", "\"\<\!\(\*SubscriptBox[OverscriptBox[\(d\), \(_\)], \(R\)]\
\)\>\""}], ",", 
           
           RowBox[{"\"\<ec\>\"", 
            "->", "\"\<\!\(\*SubscriptBox[OverscriptBox[\(e\), \(_\)], \(R\)]\
\)\>\""}], ",", 
           
           RowBox[{"\"\<Nc\>\"", 
            "->", "\"\<\!\(\*SubscriptBox[OverscriptBox[\(N\), \(_\)], \(R\)]\
\)\>\""}], ",", 
           RowBox[{"\"\<H\>\"", "->", "\"\<H\>\""}], ",", 
           
           RowBox[{"\"\<Hc\>\"", 
            "->", "\"\<\!\(\*OverscriptBox[\(H\), \(_\)]\)\>\""}]}], "}"}]}], 
        "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Extract", " ", "current", " ", "edge", " ", "labels"}], "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"edgeLabels", "=", 
      RowBox[{"EdgeLabels", "/.", " ", 
       RowBox[{"AbsoluteOptions", "[", 
        RowBox[{"fullgraph", ",", "EdgeLabels"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", "\n", 
     RowBox[{"(*", 
      RowBox[{
      "Replace", " ", "only", " ", "the", " ", "labels", " ", "of", " ", 
       "the", " ", "form", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<S\>\"", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", "1", "}"}], ",", 
         RowBox[{"1", "/", "2"}]}], "}"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"newEdgeLabels", "=", 
      RowBox[{"edgeLabels", "/.", " ", 
       RowBox[{
        RowBox[{"s", ":", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"x", ":", 
            RowBox[{"(", 
             RowBox[{"\"\<S\>\"", "|", "\"\<F\>\"", "|", "\"\<V\>\""}], 
             ")"}]}], ",", "__"}], "}"}]}], ":>", 
        RowBox[{"transformListGeneral", "[", "s", "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"TreePlot", "[", 
       RowBox[{
        RowBox[{"SetProperty", "[", 
         RowBox[{"fullgraph", ",", 
          RowBox[{"EdgeLabels", "->", "newEdgeLabels"}]}], "]"}], ",", 
        "Right", ",", 
        RowBox[{"VertexStyle", "->", "Black"}], ",", 
        RowBox[{"VertexSize", "\[Rule]", "Tiny"}], ",", 
        RowBox[{"PlotStyle", "->", "Thick"}], ",", 
        RowBox[{"EdgeLabelStyle", "\[Rule]", 
         RowBox[{"Directive", "[", "15", "]"}]}]}], "]"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.972503101178885*^9, 3.972503235065338*^9}, {
   3.97250327836528*^9, 3.972503283029141*^9}, {3.972503334118161*^9, 
   3.972503338736229*^9}, {3.972503435256591*^9, 3.972503466522401*^9}, {
   3.9725035651634007`*^9, 3.972503628837613*^9}, 3.97250368330084*^9, 
   3.972503724666082*^9, {3.972503827104344*^9, 3.972503862593576*^9}, 
   3.9725039307670517`*^9, {3.972504050115159*^9, 3.9725040724126167`*^9}, 
   3.972504780841875*^9, {3.972504816556643*^9, 3.972504842125536*^9}, {
   3.9725048787950277`*^9, 3.9725049025945063`*^9}, {3.9725049357360067`*^9, 
   3.972504992025763*^9}, {3.972505038177862*^9, 3.972505063742353*^9}, {
   3.9725051180888433`*^9, 3.9725051492959547`*^9}, {3.9725052197525263`*^9, 
   3.972505242713582*^9}, {3.972505351735276*^9, 3.972505374672615*^9}, {
   3.972505417962657*^9, 3.972505470396103*^9}, {3.972505511995438*^9, 
   3.97250559160415*^9}, {3.972505742350671*^9, 3.972505834976371*^9}, {
