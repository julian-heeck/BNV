  3.970168416727145*^9, 
  3.970168416880869*^9}},ExpressionUUID->"7913309c-52ca-41f2-9ae6-\
a80da12aaed1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<IGraphM`\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ParallelNeeds", "[", "\"\<IGraphM`\>\"", "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.969361393633*^9, 3.9693614007491617`*^9}, {
   3.969361466415326*^9, 3.9693614689262753`*^9}, 3.970168407764449*^9, 
   3.972050079162475*^9},
 CellLabel->"In[60]:=",ExpressionUUID->"149de678-74a9-4cd3-9310-723b5daf7993"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CompareUVCompletionsQ", "[", 
   RowBox[{"UVComp1_", ",", "UVComp2_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "graph1", ",", "graph2", ",", "edgeLabels1", ",", "edgeLabels2", ",", 
      "uniqueLabels", ",", "colorIndexAssoc", ",", "edgeColorAssoc1", ",", 
      "edgeColorAssoc2", ",", "extPar1", ",", "extPar2", ",", "mediators1", ",",
       "mediators2", ",", "DropChirality"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Topologies", ";", " ", 
       RowBox[{"only", " ", "checking", " ", "vertex", " ", "structure"}]}], ",",
       " ", 
      RowBox[{
       RowBox[{"i", ".", "e", ".", " ", "same"}], " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<F\>\"", ",", "\"\<F\>\"", ",", "\"\<NB\>\""}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\"\<F\>\"", ",", "\"\<NF\>\"", ",", "\"\<S\>\""}], "}"}], ",",
          "..."}], "}"}], " ", "to", " ", "make", " ", "it", " ", 
       "insensitive", " ", "to", " ", "particle", " ", "numbering"}]}], 
     "*)"}], "\n", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"VertexStructure", "[", 
              RowBox[{"UVComp1", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], "===", 
             RowBox[{"VertexStructure", "[", 
              RowBox[{"UVComp2", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ")"}]}], ",", 
          RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", "Operators", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"extPar1", "=", 
         RowBox[{"TakeWhile", "[", 
          RowBox[{
           RowBox[{"UVComp1", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "StringQ"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"extPar2", "=", 
         RowBox[{"TakeWhile", "[", 
          RowBox[{
           RowBox[{"UVComp2", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "StringQ"}], "]"}]}], ";", 
        "\n", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Sort", "[", "extPar1", "]"}], "===", 
             RowBox[{"Sort", "[", "extPar2", "]"}]}], ")"}]}], ",", 
          RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Mediators", ",", " ", 
          RowBox[{"dropping", " ", 
           RowBox[{"chirality", ":"}]}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"DropChirality", "[", "expr_", "]"}], ":=", 
         RowBox[{"expr", " ", "/.", " ", 
          RowBox[{"{", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{
              RowBox[{"Scalar", " ", 
               RowBox[{"(", "S", ")"}]}], ":", 
              RowBox[{"{", "0", "}"}]}], ",", 
             RowBox[{"{", "0", "}"}]}], "*)"}], 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", "0", "}"}], ",", " ", 
               RowBox[{"{", "0", "}"}], ",", " ", "rest___"}], "}"}], " ", ":>",
              " ", 
             RowBox[{"{", 
              RowBox[{"\"\<S\>\"", ",", "rest"}], "}"}]}], ",", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{
               RowBox[{"Fermion", " ", 
                RowBox[{"(", "F", ")"}]}], ":", 
               RowBox[{"{", "0", "}"}]}], ",", 
              RowBox[{
               RowBox[{"{", "1", "}"}], " ", "or", " ", 
               RowBox[{"{", "1", "}"}]}], ",", 
              RowBox[{"{", "0", "}"}]}], "*)"}], 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", "0", "}"}], ",", " ", 
               RowBox[{"{", "1", "}"}], ",", "rest___"}], "}"}], " ", ":>", 
             " ", 
             RowBox[{"{", 
              RowBox[{"\"\<F\>\"", ",", " ", "rest"}], "}"}]}], ",", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", "1", "}"}], ",", " ", 
               RowBox[{"{", "0", "}"}], ",", " ", "rest___"}], "}"}], " ", ":>",
              " ", 
             RowBox[{"{", 
              RowBox[{"\"\<F\>\"", ",", "rest"}], "}"}]}], ",", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{
               RowBox[{"Vector", " ", 
                RowBox[{"(", "V", ")"}]}], ":", 
               RowBox[{"{", "1", "}"}]}], ",", 
              RowBox[{"{", "1", "}"}]}], "*)"}], 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", "1", "}"}], ",", " ", 
               RowBox[{"{", "1", "}"}], ",", " ", "rest___"}], "}"}], " ", ":>",
              " ", 
             RowBox[{"{", 
              RowBox[{"\"\<V\>\"", ",", " ", "rest"}], "}"}]}]}], "}"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"mediators1", "=", 
         RowBox[{"Map", "[", 
          RowBox[{"RepNaming", ",", 
           RowBox[{"DropChirality", "[", 
            RowBox[{
             RowBox[{"UVComp1", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "[", "extPar1", "]"}], "+", "1"}], ";;"}], 
              "]"}], "]"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"mediators2", "=", 
         RowBox[{"Map", "[", 
          RowBox[{"RepNaming", ",", 
           RowBox[{"DropChirality", "[", 
            RowBox[{
             RowBox[{"UVComp2", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "[", "extPar2", "]"}], "+", "1"}], ";;"}], 
              "]"}], "]"}], "]"}]}], "]"}]}], ";", "\n", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Sort", "[", "mediators1", "]"}], "===", 
             RowBox[{"Sort", "[", "mediators2", "]"}]}], ")"}]}], ",", 
          RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"do", " ", "full", " ", "graph", " ", "comparison"}], "*)"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"graph1", "=", 
        RowBox[{"DirectedGraph", "[", 
         RowBox[{"FullParticleDiagram", "[", "UVComp1", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"graph2", "=", 
        RowBox[{"DirectedGraph", "[", 
         RowBox[{"FullParticleDiagram", "[", "UVComp2", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"edgeLabels1", "=", 
        RowBox[{"Cases", "[", 
         RowBox[{
          RowBox[{"EdgeLabels", "/.", " ", 
           RowBox[{"AbsoluteOptions", "[", 
            RowBox[{"graph1", ",", "EdgeLabels"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"Rule", "[", 
            RowBox[{"e_", ",", 
             RowBox[{"Placed", "[", 
              RowBox[{
               RowBox[{"Text", "[", 
                RowBox[{"label_", ",", "___"}], "]"}], ",", "___"}], "]"}]}], 
            "]"}], ":>", 
           RowBox[{"(", 
            RowBox[{"e", "->", "label"}], ")"}]}]}], "]"}]}], ";"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"sometimes", " ", "we", " ", "use", " ", 
         RowBox[{"Placed", "[", 
          RowBox[{"Style", "[", 
           RowBox[{"Text", "[", "..", "]"}], "]"}], "]"}], " ", "in", " ", 
         "our", " ", "graphs", " ", "instead", " ", "of", " ", 
         RowBox[{"Placed", "[", 
          RowBox[{"Text", "[", "..", "]"}], "]"}]}], ",", " ", 
        RowBox[{"make", " ", "sure", " ", "we", " ", "catch", " ", 
         RowBox[{"that", ":"}]}]}], "*)"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"edgeLabels1", "==", 
         RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"edgeLabels1", "=", 
          RowBox[{"Cases", "[", 
           RowBox[{
            RowBox[{"EdgeLabels", "/.", " ", 
             RowBox[{"AbsoluteOptions", "[", 
              RowBox[{"graph1", ",", "EdgeLabels"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"Rule", "[", 
              RowBox[{"e_", ",", 
               RowBox[{"Placed", "[", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{
                   RowBox[{"Text", "[", 
                    RowBox[{"label_", ",", "___"}], "]"}], ",", "___"}], 
                  "]"}], ",", "___"}], "]"}]}], "]"}], ":>", 
             RowBox[{"(", 
              RowBox[{"e", "->", "label"}], ")"}]}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"edgeLabels2", "=", 
          RowBox[{"Cases", "[", 
           RowBox[{
            RowBox[{"EdgeLabels", "/.", " ", 
             RowBox[{"AbsoluteOptions", "[", 
              RowBox[{"graph2", ",", "EdgeLabels"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"Rule", "[", 
              RowBox[{"e_", ",", 
               RowBox[{"Placed", "[", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{
                   RowBox[{"Text", "[", 
                    RowBox[{"label_", ",", "___"}], "]"}], ",", "___"}], 
                  "]"}], ",", "___"}], "]"}]}], "]"}], ":>", 
             RowBox[{"(", 
              RowBox[{"e", "->", "label"}], ")"}]}]}], "]"}]}], ";"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"edgeLabels2", "=", 
          RowBox[{"Cases", "[", 
           RowBox[{
            RowBox[{"EdgeLabels", "/.", " ", 
             RowBox[{"AbsoluteOptions", "[", 
              RowBox[{"graph2", ",", "EdgeLabels"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"Rule", "[", 
              RowBox[{"e_", ",", 
               RowBox[{"Placed", "[", 
                RowBox[{
                 RowBox[{"Text", "[", 
                  RowBox[{"label_", ",", "___"}], "]"}], ",", "___"}], 
                "]"}]}], "]"}], ":>", 
             RowBox[{"(", 
              RowBox[{"e", "->", "label"}], ")"}]}]}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"uniqueLabels", "=", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{"edgeLabels1", ",", "edgeLabels2"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", "\n", 
      RowBox[{"colorIndexAssoc", "=", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{"uniqueLabels", "->", 
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "uniqueLabels", "]"}], "]"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"edgeColorAssoc1", "=", 
       RowBox[{"Association", "[", 
        RowBox[{"edgeLabels1", "/.", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"e_", "->", "label_"}], ")"}], ":>", 
          RowBox[{"(", 
           RowBox[{"e", "->", 
            RowBox[{"colorIndexAssoc", "[", "label", "]"}]}], ")"}]}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"edgeColorAssoc2", "=", 
       RowBox[{"Association", "[", 
        RowBox[{"edgeLabels2", "/.", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"e_", "->", "label_"}], ")"}], ":>", 
          RowBox[{"(", 
           RowBox[{"e", "->", 
            RowBox[{"colorIndexAssoc", "[", "label", "]"}]}], ")"}]}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Normal", "[", "edgeColorAssoc1", "]"}], "==", 
          RowBox[{"{", "}"}]}], "||", 
         RowBox[{
          RowBox[{"Normal", "[", "edgeColorAssoc2", "]"}], "==", 
          RowBox[{"{", "}"}]}]}], ",", 
        RowBox[{
         RowBox[{"Print", "[", "\"\<something is wrong\>\"", "]"}], ";"}]}], 
       "]"}], ";"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "now", " ", "we", " ", "have", " ", "two", " ", "directed", " ", 
        "graphs", " ", "with", " ", "colored", " ", "edges"}], ",", " ", 
       RowBox[{"use", " ", 
        RowBox[{"IGraph", "/", 
         RowBox[{"M", "'"}]}], "s", " ", "IGVF2IsomorphicQ", " ", "to", " ", 
        "check", " ", "their", " ", 
        RowBox[{"isomorphism", ":"}]}]}], "*)"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"Return", "[", 
      RowBox[{"IGVF2IsomorphicQ", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"graph1", ",", 
          RowBox[{"\"\<EdgeColors\>\"", "->", "edgeColorAssoc1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"graph2", ",", 
          RowBox[{"\"\<EdgeColors\>\"", "->", "edgeColorAssoc2"}]}], "}"}]}], 
       "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.969279630071529*^9, 3.9692796788741817`*^9}, {
   3.9692797107688704`*^9, 3.969279739714023*^9}, {3.96928002770711*^9, 
   3.969280034331669*^9}, {3.969280067863106*^9, 3.9692800778531017`*^9}, {
   3.969280108404743*^9, 3.969280156531501*^9}, {3.9692803167928143`*^9, 
   3.96928036305965*^9}, {3.969280426306326*^9, 3.969280507295083*^9}, {
   3.969280664029251*^9, 3.969280665682066*^9}, {3.969280705451375*^9, 
   3.969280749177607*^9}, {3.969280809515451*^9, 3.969280869773157*^9}, {
   3.969280982901719*^9, 3.969281010355014*^9}, {3.969281141785284*^9, 
   3.969281148914381*^9}, {3.969281427604785*^9, 3.9692814692953167`*^9}, {
   3.969281553972434*^9, 3.9692815561547422`*^9}, {3.969281594762063*^9, 
   3.9692816263215427`*^9}, {3.969282163758032*^9, 3.969282183814302*^9}, {
   3.9692822185928087`*^9, 3.969282253932444*^9}, {3.969282342493112*^9, 
   3.969282377175098*^9}, {3.96928241524605*^9, 3.969282415691814*^9}, {
   3.9692824473432713`*^9, 3.969282537336587*^9}, {3.969282570016165*^9, 
   3.9692826578303957`*^9}, {3.969282689756369*^9, 3.9692827067271557`*^9}, 
