Cell[TextData[{
 "All particles form representations under ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"SU", "(", "2", ")"}], "left"], 
    SubscriptBox[
     RowBox[{"xSU", "(", "2", ")"}], "right"]}], TraditionalForm]],
  ExpressionUUID->"78a12397-831a-4fdb-ae95-2ed67163f2c6"],
 "x",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"SU", "(", "3", ")"}], "color"], 
    SubscriptBox[
     RowBox[{"xSU", "(", "2", ")"}], "L"]}], TraditionalForm]],ExpressionUUID->
  "089139a7-6844-41f1-8e2f-df7944e46ffa"],
 "x",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"U", "(", "1", ")"}], "Y"], TraditionalForm]],ExpressionUUID->
  "1d0210ed-b6f5-4a03-b613-3ef08977411b"],
 ", where hypercharge is related to electric charge Q by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Q", " ", "=", " ", 
    RowBox[{
     SubscriptBox["T", "3"], "+", 
     RowBox[{"Y", "."}]}]}], TraditionalForm]],ExpressionUUID->
  "1acc026c-50f8-4e5f-9747-10464b86846c"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"SU", "(", "2", ")"}], "left"], 
    SubscriptBox[
     RowBox[{"xSU", "(", "2", ")"}], "right"]}], TraditionalForm]],
  ExpressionUUID->"d02a55d4-8d5d-4b91-90e8-13ff8d98e9da"],
 " corresponds to the Lorentz group: scalars are (1,1) (i.e. singlets under \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"SU", "(", "2", ")"}], "left"], 
    SubscriptBox[
     RowBox[{"xSU", "(", "2", ")"}], "right"]}], TraditionalForm]],
  ExpressionUUID->"0c37b353-8de4-4f88-b2c5-cd3253c7a5fd"],
 "), left-handed fermions are (2,1), right-handed (1,2) (i.e. doublets under \
one of the SU(2)), and vectors are (2,2). In GroupMath, these representations \
are written using Dynkin coefficients, so an SU(2) singlet 1 is written as \
{0}, a doublet as {1}, a triplet at {2}, etc. An SU(3) triplet 3 is written \
as {1,0}, an anti-triplet ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["3", "_"], TraditionalForm]],ExpressionUUID->
  "595ee6f1-062b-4d9c-9780-e231d3a65d6a"],
 "  as {0,1}, etc, see GroupMath documentation.\n\nStandard Model particles \
(plus right-handed neutrinos NR):"
}], "Text",
 CellChangeTimes->{{3.905503697074378*^9, 3.905503717694209*^9}, {
  3.9055091591009073`*^9, 3.905509217429779*^9}, {3.916777522324019*^9, 
  3.91677752375688*^9}, {3.91682459429573*^9, 3.916824626589926*^9}, {
  3.936175125007872*^9, 3.936175190329914*^9}, {3.936175246633718*^9, 
  3.936175404043112*^9}, {3.971966589779416*^9, 3.971966590402273*^9}, {
  3.971966823527164*^9, 3.971966995322846*^9}, {3.9786117443152246`*^9, 
  3.9786117454235897`*^9}, {3.982159838546526*^9, 
  3.982159840921983*^9}},ExpressionUUID->"c14a70fc-cc26-40b8-a143-\
09ace5c75642"],

