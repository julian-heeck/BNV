Cell["\<\
So the operator H H dR L dR Q has B=1, L=1, d=8, 4 fermions, and 2 scalars.\
\>", "Text",
 CellChangeTimes->{{3.9733337084665937`*^9, 3.973333745148089*^9}, {
  3.9843182382959833`*^9, 
  3.984318255386702*^9}},ExpressionUUID->"92198d49-701a-4107-9801-\
5c2d61b1e085"],

Cell["\<\
Notice that our UV completions have been stripped of their chirality \
structure, i.e. whether internal fermions are left- or right-handed. Since \
all fermions are massive and we enforce a chirality flip on each internal \
fermion line, both chiralities are present and this omission seems innocuous. \
The only reason to keep the chirality structure is to check for \
AsymmetricHiggsQ -- which is unnecessary since we have already removed UV \
completions with AsymmetricHiggsQ == True -- or to calculate the amplitude. \
We provide the function ReconstructQuantumNumbers to restore the chirality \
information by going through the diagram and flipping fermion chiralities as \
necessary to get valid vertices:\
\>", "Text",
 CellChangeTimes->{{3.984318275559347*^9, 3.98431861723383*^9}, {
  3.984318648243618*^9, 3.984318657604644*^9}, {3.9843187217633963`*^9, 
  3.984318738805895*^9}, {3.984318771432721*^9, 
  3.984318808613542*^9}},ExpressionUUID->"c4a89e33-f2f5-45fe-9c83-\
30dc2dd349d1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ReconstructQuantumNumbers", "[", "x_", "]"}], ":=", 
    RowBox[{"RestoreUVChirality", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"Map", "[", 
        RowBox[{"LookupNewParticle", ",", 
         RowBox[{"x", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RestoreUVChirality", "[", "uvcompletion_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"vertex", ",", 
      RowBox[{"vertexfactors", "=", 
       RowBox[{"{", "}"}]}], ",", "vertexproduct", ",", "Hlabels", ",", 
      "Hclabels", ",", 
      RowBox[{"totalantisymlist", "=", 
       RowBox[{"{", "}"}]}], ",", "w", ",", "inv", ",", "k", ",", "particles",
       ",", "in", ",", "FlipChirality", ",", "RewriteInUVCodeConvention", ",",
       "topology"}], "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Just", " ", "flips", " ", "the", " ", "Lorentz", " ", "SU", 
       RowBox[{"(", "2", ")"}], "xSU", 
       RowBox[{"(", "2", ")"}], " ", "indices"}], ",", 
      RowBox[{
       RowBox[{"i", ".", "e", ".", "the"}], " ", "chirality"}]}], "*)"}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"FlipChirality", "[", "list_", "]"}], ":=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"list", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"list", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"list", "[", 
          RowBox[{"[", "3", "]"}], "]"}], ",", 
         RowBox[{"list", "[", 
          RowBox[{"[", "4", "]"}], "]"}], ",", 
         RowBox[{"list", "[", 
          RowBox[{"[", "5", "]"}], "]"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"RewriteInUVCodeConvention", "[", "x_", "]"}], ":=", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"h", "=", 
           RowBox[{"x", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Which", "[", 
            RowBox[{
             RowBox[{"h", "===", "\"\<F\>\""}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", "0", "}"}], ",", 
               RowBox[{"{", "1", "}"}]}], "}"}], ",", 
             RowBox[{"h", "===", "\"\<S\>\""}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", "0", "}"}], ",", 
               RowBox[{"{", "0", "}"}]}], "}"}], ",", 
             RowBox[{"h", "===", "\"\<V\>\""}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", "1", "}"}], ",", 
               RowBox[{"{", "1", "}"}]}], "}"}], ",", 
             RowBox[{"MatchQ", "[", 
              RowBox[{"h", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"_Integer", ".."}], "}"}], ".."}], "}"}]}], "]"}], ",",
              "h", ",", "True", ",", 
             RowBox[{"{", "h", "}"}]}], "]"}], ",", 
           RowBox[{"Rest", "[", "x", "]"}]}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"topology", "=", 
       RowBox[{"uvcompletion", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
        RowBox[{"convert", " ", "our", " ", "chirality"}], "-", 
        RowBox[{
        "stripped", " ", "uv", " ", "completion", " ", "to", " ", "the", " ", 
         "notation", " ", "including", " ", 
         RowBox[{"chirality", ".", "For"}], " ", "external", " ", 
         "particles"}]}], ",", 
       RowBox[{
        RowBox[{"this", " ", "is", " ", "unique"}], ";", 
        RowBox[{"for", " ", "internal", " ", "particles"}]}], ",", 
       RowBox[{"we", " ", 
        RowBox[{"don", "'"}], "t", " ", "know", " ", "if", " ", "they", " ", 
        "should", " ", "be", " ", "chirality", " ", "flipped"}]}], "*)"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"particles", "=", 
      RowBox[{"Map", "[", 
       RowBox[{"RewriteInUVCodeConvention", ",", 
        RowBox[{
         RowBox[{"uvcompletion", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "/.", " ", 
         "InverseReplaceSMnames"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "run", " ", "over", " ", "all", " ", "the", " ", "vertices", " ", "in",
         " ", "the", " ", "diagram"}], ",", 
       RowBox[{"except", " ", "the", " ", "last", " ", "one"}], ",", 
       RowBox[{
       "and", " ", "calculate", " ", "the", " ", "full", " ", "group", " ", 
        "invariants", " ", "at", " ", "each", " ", "vertex"}], ",", 
       RowBox[{
       "renaming", " ", "the", " ", "multiplets", " ", "by", " ", "particle", 
        " ", "labels", " ", "p1"}], ",", "p2", ",", 
       RowBox[{
       "p3", " ", "etc", " ", "that", " ", "match", " ", "the", " ", 
        "labelling", " ", "in", " ", "the", " ", 
        RowBox[{"topology", ".", "We"}], " ", "treat", " ", "all", " ", "but",
         " ", "the", " ", "last", " ", "particle", " ", "in", " ", "each", " ",
         "vertex", " ", "as", " ", "incoming"}], ",", 
       RowBox[{
       "and", " ", "the", " ", "last", " ", "one", " ", "as", " ", "outgoing",
         " ", 
        RowBox[{"(", 
         RowBox[{"Conjugations", "->", "True"}], ")"}]}], ",", 
       RowBox[{
        RowBox[{
        "following", " ", "the", " ", "same", " ", "logic", " ", "as", " ", 
         "in", " ", 
         RowBox[{"UVCompletions", ".", "We"}], " ", "distinguish", " ", "3", " ",
          "and", " ", "4"}], "-", 
        RowBox[{"particle", " ", 
         RowBox[{"vertices", ":"}]}]}]}], "*)"}], 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"vertex", "=", "1"}], ",", 
       RowBox[{"vertex", "<", 
        RowBox[{"Length", "[", 
         RowBox[{"topology", "[", 
          RowBox[{"[", "3", "]"}], "]"}], "]"}]}], ",", 
       RowBox[{"vertex", "++"}], ",", 
       RowBox[{"(*", 
        RowBox[{"3", "-", 
         RowBox[{"particle", " ", "vertex"}]}], "*)"}], 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{
             RowBox[{"topology", "[", 
              RowBox[{"[", "3", "]"}], "]"}], "[", 
             RowBox[{"[", "vertex", "]"}], "]"}], "]"}], "==", "3"}], ",", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
            "check", " ", "if", " ", "the", " ", "vertex", " ", "is", " ", 
             "invariant"}], ",", 
            RowBox[{
             RowBox[{"i", ".", "e", ".", 
              RowBox[{"Length", "[", "inv", "]"}]}], "!=", "0"}], ",", 
            RowBox[{"if", " ", "yes"}], ",", 
            RowBox[{
            "all", " ", "good", " ", "and", " ", "move", " ", "on"}]}], 
           "*)"}], 
          RowBox[{
           RowBox[{"Which", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"Invariants", "[", 
                RowBox[{"group", ",", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"particles", "[", 
                    RowBox[{"[", 
                    RowBox[{"topology", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "vertex", ",", "1"}], "]"}], "]"}], 
                    "]"}], "]"}], ",", 
                    RowBox[{"particles", "[", 
                    RowBox[{"[", 
                    RowBox[{"topology", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "vertex", ",", "2"}], "]"}], "]"}], 
                    "]"}], "]"}], ",", 
                    RowBox[{"particles", "[", 
                    RowBox[{"[", 
                    RowBox[{"topology", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "vertex", ",", "3"}], "]"}], "]"}], 
                    "]"}], "]"}]}], "}"}], "/.", " ", 
                  "InverseReplaceSMnames"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"Conjugations", "->", 
                   RowBox[{"{", 
                    RowBox[{"False", ",", "False", ",", "True"}], "}"}]}], 
                  "}"}]}], "]"}], "]"}], "!=", "0"}], ",", "Null", ",", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"if", " ", "that", " ", 
                RowBox[{"didn", "'"}], "t", " ", "work"}], ",", 
               RowBox[{
                RowBox[{"try", " ", "chirality"}], "-", 
                RowBox[{
                "flipping", " ", "the", " ", "last", " ", "particle", " ", 
                 "and", " ", "see", " ", "if", " ", "the", " ", "vertex", " ",
                  "is", " ", "invariant", " ", 
                 RowBox[{"now", ".", "If"}], " ", "yes"}]}], ",", 
               RowBox[{
               "that", " ", "is", " ", "the", " ", "right", " ", "thing", " ",
                 "to", " ", "do", " ", "and", " ", "we", " ", "update", " ", 
                "the", " ", "quantum", " ", "numbers", " ", "in", 
                " ", "\"\<particles\>\""}]}], "*)"}], 
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"Invariants", "[", 
                RowBox[{"group", ",", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"particles", "[", 
                    RowBox[{"[", 
                    RowBox[{"topology", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "vertex", ",", "1"}], "]"}], "]"}], 
                    "]"}], "]"}], ",", 
                    RowBox[{"particles", "[", 
                    RowBox[{"[", 
                    RowBox[{"topology", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "vertex", ",", "2"}], "]"}], "]"}], 
                    "]"}], "]"}], ",", 
                    RowBox[{"FlipChirality", "[", 
                    RowBox[{"particles", "[", 
                    RowBox[{"[", 
                    RowBox[{"topology", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "vertex", ",", "3"}], "]"}], "]"}], 
                    "]"}], "]"}], "]"}]}], "}"}], "/.", " ", 
                  "InverseReplaceSMnames"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"Conjugations", "->", 
                   RowBox[{"{", 
                    RowBox[{"False", ",", "False", ",", "True"}], "}"}]}], 
                  "}"}]}], "]"}], "]"}], "!=", "0"}], ",", 
             RowBox[{
              RowBox[{"particles", "[", 
               RowBox[{"[", 
                RowBox[{"topology", "[", 
                 RowBox[{"[", 
                  RowBox[{"3", ",", "vertex", ",", "3"}], "]"}], "]"}], "]"}],
                "]"}], "=", 
              RowBox[{"FlipChirality", "[", 
               RowBox[{"particles", "[", 
                RowBox[{"[", 
                 RowBox[{"topology", "[", 
                  RowBox[{"[", 
                   RowBox[{"3", ",", "vertex", ",", "3"}], "]"}], "]"}], 
                 "]"}], "]"}], "]"}]}], ",", 
             RowBox[{"(*", 
              RowBox[{
              "if", " ", "nothing", " ", "worked", " ", "print", " ", "error",
                " ", "message"}], "*)"}], "True", ",", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<couldn't construct invariant 3-vertex \>\"", ",", 
               RowBox[{
                RowBox[{"topology", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], "[", 
                RowBox[{"[", "vertex", "]"}], "]"}]}], "]"}]}], "]"}], ";"}], 
          ",", 
          RowBox[{"(*", 
           RowBox[{"4", "-", 
            RowBox[{"particle", " ", "vertex"}]}], "*)"}], 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
            "check", " ", "if", " ", "the", " ", "vertex", " ", "is", " ", 
             "invariant"}], ",", 
            RowBox[{
             RowBox[{"i", ".", "e", ".", 
              RowBox[{"Length", "[", "inv", "]"}]}], "!=", "0"}], ",", 
            RowBox[{"if", " ", "yes"}], ",", 
            RowBox[{
            "all", " ", "good", " ", "and", " ", "move", " ", "on"}]}], 
           "*)"}], 
          RowBox[{
           RowBox[{"Which", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"Invariants", "[", 
                RowBox[{"group", ",", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"particles", "[", 
                    RowBox[{"[", 
                    RowBox[{"topology", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "vertex", ",", "1"}], "]"}], "]"}], 
                    "]"}], "]"}], ",", 
                    RowBox[{"particles", "[", 
                    RowBox[{"[", 
                    RowBox[{"topology", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "vertex", ",", "2"}], "]"}], "]"}], 
                    "]"}], "]"}], ",", 
                    RowBox[{"particles", "[", 
                    RowBox[{"[", 
                    RowBox[{"topology", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "vertex", ",", "3"}], "]"}], "]"}], 
                    "]"}], "]"}], ",", 
                    RowBox[{"particles", "[", 
                    RowBox[{"[", 
                    RowBox[{"topology", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "vertex", ",", "4"}], "]"}], "]"}], 
                    "]"}], "]"}]}], "}"}], "/.", " ", 
                  "InverseReplaceSMnames"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"Conjugations", "->", 
                   RowBox[{"{", 
                    RowBox[{
                    "False", ",", "False", ",", "False", ",", "True"}], 
                    "}"}]}], "}"}]}], "]"}], "]"}], "!=", "0"}], ",", "Null", 
             ",", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"if", " ", "that", " ", 
                RowBox[{"didn", "'"}], "t", " ", "work"}], ",", 
               RowBox[{
                RowBox[{"try", " ", "chirality"}], "-", 
                RowBox[{
                "flipping", " ", "the", " ", "last", " ", "particle", " ", 
                 "and", " ", "see", " ", "if", " ", "the", " ", "vertex", " ",
                  "is", " ", "invariant", " ", 
                 RowBox[{"now", ".", "If"}], " ", "yes"}]}], ",", 
               RowBox[{
               "that", " ", "is", " ", "the", " ", "right", " ", "thing", " ",
                 "to", " ", "do", " ", "and", " ", "we", " ", "update", " ", 
                "the", " ", "quantum", " ", "numbers", " ", "in", 
                " ", "\"\<particles\>\""}]}], "*)"}], 
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"Invariants", "[", 
                RowBox[{"group", ",", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"particles", "[", 
                    RowBox[{"[", 
                    RowBox[{"topology", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "vertex", ",", "1"}], "]"}], "]"}], 
                    "]"}], "]"}], ",", 
                    RowBox[{"particles", "[", 
                    RowBox[{"[", 
                    RowBox[{"topology", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "vertex", ",", "2"}], "]"}], "]"}], 
                    "]"}], "]"}], ",", 
                    RowBox[{"particles", "[", 
                    RowBox[{"[", 
                    RowBox[{"topology", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "vertex", ",", "3"}], "]"}], "]"}], 
                    "]"}], "]"}], ",", 
                    RowBox[{"FlipChirality", "[", 
                    RowBox[{"particles", "[", 
                    RowBox[{"[", 
                    RowBox[{"topology", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "vertex", ",", "4"}], "]"}], "]"}], 
                    "]"}], "]"}], "]"}]}], "}"}], "/.", " ", 
                  "InverseReplaceSMnames"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"Conjugations", "->", 
                   RowBox[{"{", 
                    RowBox[{
                    "False", ",", "False", ",", "False", ",", "True"}], 
                    "}"}]}], "}"}]}], "]"}], "]"}], "!=", "0"}], ",", 
             RowBox[{
              RowBox[{"particles", "[", 
               RowBox[{"[", 
                RowBox[{"topology", "[", 
                 RowBox[{"[", 
                  RowBox[{"3", ",", "vertex", ",", "4"}], "]"}], "]"}], "]"}],
                "]"}], "=", 
              RowBox[{"FlipChirality", "[", 
               RowBox[{"particles", "[", 
                RowBox[{"[", 
                 RowBox[{"topology", "[", 
                  RowBox[{"[", 
                   RowBox[{"3", ",", "vertex", ",", "4"}], "]"}], "]"}], 
                 "]"}], "]"}], "]"}]}], ",", 
             RowBox[{"(*", 
              RowBox[{
              "if", " ", "nothing", " ", "worked", " ", "print", " ", "error",
                " ", "message"}], "*)"}], "True", ",", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<couldn't construct invariant 4-vertex \>\"", ",", 
               RowBox[{
                RowBox[{"topology", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], "[", 
                RowBox[{"[", "vertex", "]"}], "]"}]}], "]"}]}], "]"}], 
           ";"}]}], "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"At", " ", "the", " ", "last", " ", "vertex"}], ",", 
       RowBox[{
       "all", " ", "particles", " ", "are", " ", "incoming", " ", "and", " ", 
        
        RowBox[{"we", "'"}], "ve", " ", "already", " ", "corrected", " ", 
        "all", " ", "quantum", " ", "numbers", " ", "in", 
        " ", "\"\<particles\>\""}], ",", 
       RowBox[{
       "so", " ", "the", " ", "vertices", " ", "should", " ", "come", " ", 
        "out", " ", "invariant"}], ",", 
       RowBox[{"otherwise", " ", "same", " ", "procedure"}], ",", 
       RowBox[{
       "the", " ", "group", " ", "invariants", " ", "for", " ", "each", " ", 
        "vertex", " ", "are", " ", "added", " ", "to", " ", "the", " ", 
        "list", " ", 
        RowBox[{"vertexfactors", ":"}]}]}], "*)"}], 
     RowBox[{"vertex", "=", 
      RowBox[{"Length", "[", 
       RowBox[{"topology", "[", 
        RowBox[{"[", "3", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
