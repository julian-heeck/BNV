Cell[TextData[{
 "This amplitude depends on the external particle wavefunctions or multiplet \
components; p4[a,b,c,d] stands for the \[OpenCurlyDoubleQuote]eR\
\[CloseCurlyDoubleQuote] field, a is the component under the Lorentz ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"SU", "(", "2", ")"}], "left"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9bbbce35-c025-44f7-b51b-05e35c280e81"],
 ", which is always 1 here since eR is in the singlet representation of this \
group; b is the component under ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"SU", "(", "2", ")"}], "right"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0ee5bee8-3afd-4936-847a-33f67e8fddaf"],
 ", which takes values from 1 to 2; c stands for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"SU", "(", "3", ")"}], "color"], ",", " ", 
    RowBox[{
    "so", " ", "this", " ", "is", " ", "again", " ", "just", " ", "fixed", " ",
      "to", " ", "1", " ", "for", " ", "eR"}], ",", " ", 
    RowBox[{"same", " ", "for", " ", "d"}], ",", " ", 
    RowBox[{"which", " ", "labels", " ", 
     RowBox[{
      SubscriptBox[
       RowBox[{"SU", "(", "2", ")"}], "L"], "."}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b409ff33-c581-4dff-977d-9c8b9b20dbfb"],
 " So eR only has two components, p4[1, 1, 1, 1] and p4[1, 2, 1, 1]. Other \
objects, esp. Q, are more complicated. To check whether an amplitude is \
symmetric or antisymmetric under particle exchange, it is more convenient to \
treat this as a function of p1,...p4:"
}], "Text",
 CellChangeTimes->{{3.972487518691773*^9, 3.97248754735308*^9}, {
  3.972487587014732*^9, 3.9724877905230427`*^9}, {3.97248782880405*^9, 
  3.972487871331991*^9}},ExpressionUUID->"7d95d233-44d9-4182-8c29-\
cb1033ee5010"],

Cell[BoxData[
 RowBox[{
  RowBox[{"amp", "=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p1", ",", "p2", ",", "p3", ",", "p4"}], "}"}], ",", 
     RowBox[{"Evaluate", "[", 
      RowBox[{"amplitude", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           GraphicsBox[
            NamespaceBox["NetworkGraphics",
             DynamicModuleBox[{Typeset`graph = HoldComplete[
               
               Graph[{"a", "b", "c", "d", "e", "f"}, {
                Null, {{1, 2}, {3, 2}, {4, 5}, {6, 5}, {5, 2}}}, {
                EdgeLabels -> {UndirectedEdge["c", "b"] -> Placed[
                    Text["2", Background -> GrayLevel[1]], {Left, "Middle"}], 
                   UndirectedEdge["f", "e"] -> Placed[
                    Text["4", Background -> GrayLevel[1]], {Left, "Middle"}], 
                   UndirectedEdge["e", "b"] -> Placed[
                    Text["5", Background -> GrayLevel[1]], {Left, "Middle"}], 
                   UndirectedEdge["d", "e"] -> Placed[
                    Text["3", Background -> GrayLevel[1]], {Left, "Middle"}], 
                   UndirectedEdge["a", "b"] -> Placed[
