             {Arrowheads[0.], 
              ArrowBox[{{2.3763541031440183`, 0.}, {2.6733983660370204`, 
               0.5940885257860046}}, 0.03800926187013255]}}, InsetBox[
             InterpretationBox[Cell[BoxData[
               FormBox["\<\"5\"\>", TextForm]], "InlineText",
               Background->GrayLevel[1],ExpressionUUID->
               "9c4a1fc8-9709-4862-bcf3-e515131cbd15"],
              Text["5", Background -> GrayLevel[1]]], 
             Offset[{-2., 0.}, {2.5248762345905194, 0.2970442628930023}], 
             ImageScaled[{1., 0.5}],
             BaseStyle->"Graphics"]}, {
            {GrayLevel[0], 
             {Arrowheads[0.], 
              ArrowBox[{{2.6733983660370204`, 0.5940885257860046}, {
               2.9704426289300225`, 0.}}, 0.03800926187013255]}}, InsetBox[
             InterpretationBox[Cell[BoxData[
               FormBox["\<\"6\"\>", TextForm]], "InlineText",
               Background->GrayLevel[1],ExpressionUUID->
               "f7f544c8-82bf-4bb9-896b-0dd414472f41"],
              Text["6", Background -> GrayLevel[1]]], 
             Offset[{-2., 0.}, {2.8219204974835215, 0.2970442628930023}], 
             ImageScaled[{1., 0.5}],
             BaseStyle->"Graphics"]}, {
            {RGBColor[1, 0, 0], Dashing[{Small, Small}], 
             {Arrowheads[0.], 
              ArrowBox[{{2.6733983660370204`, 0.5940885257860046}, {
               2.0793098402510157`, 1.1881770515720091`}}, 
               0.03800926187013255]}}, InsetBox[
             InterpretationBox[Cell[BoxData[
               FormBox["\<\"11\"\>", TextForm]], "InlineText",
               Background->GrayLevel[1],ExpressionUUID->
               "1b04df25-5233-4756-943a-0d1146995ebd"],
              Text["11", Background -> GrayLevel[1]]], 
             Offset[{-2., 0.}, {2.376354103144018, 0.8911327886790068}], 
             ImageScaled[{1., 0.5}],
             BaseStyle->"Graphics"]}, {
            {GrayLevel[0], 
             {Arrowheads[0.], 
              ArrowBox[{{3.564531154716027, 0.}, {3.8615754176090293`, 
               0.5940885257860046}}, 0.03800926187013255]}}, InsetBox[
             InterpretationBox[Cell[BoxData[
               FormBox["\<\"7\"\>", TextForm]], "InlineText",
               Background->GrayLevel[1],ExpressionUUID->
               "75c1eea5-73f4-4fc4-b791-2b002f53bd1f"],
