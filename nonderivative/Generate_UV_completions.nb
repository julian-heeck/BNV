              RowBox[{"[", "3", "]"}], "]"}], "[", 
             RowBox[{"[", "vertex", "]"}], "]"}]}], "]"}]}], "]"}], ";"}], ",", 
       RowBox[{"(*", 
        RowBox[{"4", "-", 
         RowBox[{"particle", " ", "vertex"}]}], "*)"}], 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"Invariants", "[", 
