             Offset[{-2., 0.}, {3.7130532861625283, 0.2970442628930023}], 
             ImageScaled[{1., 0.5}],
             BaseStyle->"Graphics"]}, {
            {GrayLevel[0], 
             {Arrowheads[0.], 
              ArrowBox[{{3.8615754176090293`, 0.5940885257860046}, {
               4.1586196805020315`, 0.}}, 0.03800926187013255]}}, InsetBox[
             InterpretationBox[Cell[BoxData[
               FormBox["\<\"8\"\>", TextForm]], "InlineText",
               Background->GrayLevel[1],ExpressionUUID->
               "f91fbfd6-04d2-4642-ac6c-18f361586de8"],
              Text["8", Background -> GrayLevel[1]]], 
             Offset[{-2., 0.}, {4.01009754905553, 0.2970442628930023}], 
             ImageScaled[{1., 0.5}],
             BaseStyle->"Graphics"]}, {
            {RGBColor[1, 0, 0], Dashing[{Small, Small}], 
             {Arrowheads[0.], 
              ArrowBox[{{3.8615754176090293`, 0.5940885257860046}, {
               2.0793098402510157`, 1.1881770515720091`}}, 
               0.03800926187013255]}}, InsetBox[
             InterpretationBox[Cell[BoxData[
               FormBox["\<\"12\"\>", TextForm]], "InlineText",
               Background->GrayLevel[1],ExpressionUUID->
               "a041f216-6d63-4c04-8982-892d6200a853"],
              Text["12", Background -> GrayLevel[1]]], 
             Offset[{-2., 0.}, {2.9704426289300225, 0.8911327886790068}], 
             ImageScaled[{1., 0.5}],
             BaseStyle->"Graphics"]}}, 
          {Hue[0.6, 0.5, 1.], EdgeForm[{GrayLevel[0], Opacity[0.7]}], 
           DiskBox[{0., 0.}, 0.03800926187013255], 
           DiskBox[{0.2970442628930023, 0.5940885257860046}, 
            0.03800926187013255], 
           DiskBox[{0.5940885257860046, 0.}, 0.03800926187013255], 
           DiskBox[{1.1881770515720091`, 0.}, 0.03800926187013255], 
           DiskBox[{1.4852213144650113`, 0.5940885257860046}, 
            0.03800926187013255], 
           DiskBox[{1.7822655773580136`, 0.}, 0.03800926187013255], 
           DiskBox[{2.3763541031440183`, 0.}, 0.03800926187013255], 
           DiskBox[{2.6733983660370204`, 0.5940885257860046}, 
            0.03800926187013255], 
           DiskBox[{2.9704426289300225`, 0.}, 0.03800926187013255], 
           DiskBox[{3.564531154716027, 0.}, 0.03800926187013255], 
           DiskBox[{3.8615754176090293`, 0.5940885257860046}, 
            0.03800926187013255], 
           DiskBox[{4.1586196805020315`, 0.}, 0.03800926187013255], 
           DiskBox[{2.0793098402510157`, 1.1881770515720091`}, 
            0.03800926187013255]}}],
        MouseAppearanceTag["NetworkGraphics"]],
       AllowKernelInitialization->False]],
     DefaultBaseStyle->"NetworkGraphics",
     FormatType->TraditionalForm,
     FrameTicks->None], ",", 
    RowBox[{"{", 
     RowBox[{"\"\<S\>\"", ",", "\"\<S\>\"", ",", "\"\<F\>\"", ",", "\"\<F\>\"",
       ",", "\"\<F\>\"", ",", "\"\<F\>\"", ",", "\"\<F\>\"", ",", "\"\<F\>\"",
       ",", "\"\<NB\>\"", ",", "\"\<NB\>\"", ",", "\"\<NB\>\"", 
      ",", "\"\<NB\>\""}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2", ",", "9"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"3", ",", "4", ",", "10"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"5", ",", "6", ",", "11"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"7", ",", "8", ",", "12"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"9", ",", "10", ",", "11", ",", "12"}], "}"}]}], "}"}]}], 
   "}"}]], "Input",
  CellChangeTimes->{{3.932641968306087*^9, 3.932641993531229*^9}, 
    3.932642065540525*^9, {3.932642507935413*^9, 3.93264250916628*^9}},
  ExpressionUUID->"7113a563-bb6e-4338-8607-1cfcf804d717"],
 "\nwhere the first entry visualizes the topology and the second entry lists \
some basic properties of the particles (scalar \[OpenCurlyDoubleQuote]S\
\[CloseCurlyDoubleQuote] vs fermion \[OpenCurlyDoubleQuote]F\
\[CloseCurlyDoubleQuote] for external particles, new boson \
\[OpenCurlyDoubleQuote]NB\[CloseCurlyDoubleQuote] or new fermion \
\[OpenCurlyDoubleQuote]NF\[CloseCurlyDoubleQuote] for internal particles). \
The third entry is the important one, as it encodes the vertices, so {1,2,9} \
means particles 1, 2, and 9 meet at this vertex (see graph). \n\nTopology \
files for most cases of interest are provided by us or can be generated using \
the Generate_topologies notebook; BNV operators are provided by us, other \
operators can be readily generated using, for example, Renato Fonseca\
\[CloseCurlyQuote]s Sym2Int package (https://renatofonseca.net/sym2int).\n\
While not done here, the correct topology file could even be automatically \
picked according to the number of scalars and fermions in the operator.\n\nWe \
start with the first vertex, {1, 2, 9}, and use it to calculate the \
representation of particle 9 by multiplying the representations of particles \
1 and 2, both H in this example. Since MyReduceRepProduct[{H, H}] provides \
two solutions for particle 9, {{{0}, {0}, {0, 0}, {2}, 1}, {{0}, {0}, {0, 0}, \
{0}, 1}}, we generate a new list of lists:\n{ {H,H,Lc,Lc,dR,dR,dR,eR, {{0}, \
{0}, {0, 0}, {2}, 1}}, {H,H,Lc,Lc,dR,dR,dR,eR, {{0}, {0}, {0, 0}, {0}, 1}}}\n\
Then we go on to the second vertex, {3, 4, 10}, and multiply Lc and Lc to \
obtain the representation for particle 10 and add it to this list of lists, \
which will eventually look like\n{ {H,H,Lc,Lc,dR,dR,dR,eR, rep9, rep10, \
rep11, rep12}, {H,H,Lc,Lc,dR,dR,dR,eR, different rep9, rep10, rep11, rep12}, \
..., {H,H,Lc,Lc,dR,dR,dR,eR, rep9, different rep10, rep11, rep12}, ... }\n\
after we go through all but the last vertex. \nThen we go through all entries \
in this \[OpenCurlyDoubleQuote]particlelist\[CloseCurlyDoubleQuote] and check \
if the last vertex, {9, 10, 11, 12}, contains a singlet, and only keep the \
solutions that do. \n\nFor diagrams involving multiple Higgs doublets (or \
multiple anti-Higgs doublets) we need to make sure that vertices don\
\[CloseCurlyQuote]t vanish, which is the most involved part of this code. \
Here are the selection rules for vertices involving multiple H: \
\[LineSeparator]any H-H-H-X vertex must have an SU(2)_L  quadruplet X, as \
doublets give 0;\[LineSeparator]any H-H-X vertex must have an SU(2)_L  \
triplet X, as singlets give 0;\nat any H-H-X-Y vertex, X*Y must contain an \
SU(2)_L triplet.\nTo determine if a vertex has multiple Higgs fields, we read \
off the positions of all Higgs fields in the operator and then go through the \
third entry of the topology to see if multiple H ever meet at a vertex. For \
example, if particle 1 and 2 here are both H (rather than (H,Hc) or (Hc,Hc)), \
we need to find a vertex with {1,2,X} or {1,2,X,Y} in the vertex list. The \
functions containsTwoP and containsThreeP check for this.\n\nWe check if \
there are vertices with multiple Higgs bosons and throw away solutions where \
the vertex vanishes, which in this example is the particle 9 representation \
{{0}, {0}, {0, 0}, {0}, 1}. In models with multiple Higgs doublets this part \
of the code could be omitted.\nAll \[OpenCurlyDoubleQuote]particlelist\
\[CloseCurlyDoubleQuote] entries that pass these last checks are possible UV \
completions for the given diagram, and we output them into the list \
\[OpenCurlyDoubleQuote]viable\[CloseCurlyDoubleQuote]."
}], "Text",
 CellChangeTimes->{{3.936178407737939*^9, 3.936178444586959*^9}, {
