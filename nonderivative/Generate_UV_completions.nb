Cell["\<\
After removing equivalent UV completions and cases that vanish due to Higgs \
asymmetry, one is left with the final list \[OpenCurlyDoubleQuote]finallist\
\[CloseCurlyDoubleQuote], which can then be exported as needed. Notice that \
we do not export our UV completions in exactly this format, {{topology, uv \
completion 1}, {topology, uv completion 2},...}, because of the massive \
increase in file size due to the repetitive topology entries. Instead, we \
export our lists as {topology,{uv completion 1, uv completion 2,...}}. This \
is the format of the UV completions supplied by us.\
\>", "Text",
 CellChangeTimes->{{3.9724868967339487`*^9, 3.972487091165679*^9}, {
  3.973862345179051*^9, 
  3.973862357291727*^9}},ExpressionUUID->"28007bee-d5eb-4852-a1a0-\
1cd00d5b3001"],

Cell["\<\
Notice that one might wonder about amplitudes that vanish due to fermion \
asymmetries, similar to the Higgs asymmetry case. In our BNV cases, we \
checked that this does not happen up to d=15. We explain how to check for \
this in the next section, which requires a calculation of the amplitude.\
\>", "Text",
 CellChangeTimes->{{3.972487102675542*^9, 
  3.972487189549944*^9}},ExpressionUUID->"5d9d88cc-e2d6-4129-9d82-\
3d981e3e5c11"]
}, Closed]],

Cell[CellGroupData[{

Cell["Calculating the amplitude", "Section",
 CellChangeTimes->{{3.97216012306098*^9, 
  3.97216012995923*^9}},ExpressionUUID->"3141be8d-d0c1-4d00-8205-\
13dac269599c"],

Cell["\<\
Function that calculates the \[OpenCurlyDoubleQuote]amplitude\
\[CloseCurlyDoubleQuote] (or expands the operator) of a given UV completion \
in the constant-propagator limit and setting masses and constants to 1. The \
purpose is not the overall prefactor but the symmetry under particle \
exchange. The code is essentially the same as for the Higgs asymmetry, but \
without throwing in random numbers for the external wavefunctions at the end:\
\
\>", "Text",
 CellChangeTimes->{{3.9724872703113956`*^9, 3.972487397967168*^9}, {
  3.9821613235901937`*^9, 
  3.9821613284147673`*^9}},ExpressionUUID->"4a2032d1-e914-444f-8f5d-\
9064898c6bc6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"amplitude", "[", "uvcompletion_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"topology", ",", "vertex", ",", 
      RowBox[{"vertexfactors", "=", 
       RowBox[{"{", "}"}]}], ",", "newparticlelabels", ",", 
      "newparticlelabelsbar", ",", "newparticlestates", ",", 
      "newparticlestatesbar", ",", "vertexproduct", ",", "w", ",", "inv", ",",
       "particles", ",", "in", ",", 
      RowBox[{"finalamplitude", "=", 
       RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"topology", "=", 
         RowBox[{"uvcompletion", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"particles", "=", 
         RowBox[{
          RowBox[{"uvcompletion", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "/.", "InverseReplaceSMnames"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "figure", " ", "out", " ", "which", " ", "of", " ", "the", " ", 
           "particles", " ", "are", " ", "internal", " ", "and", " ", "need", 
           " ", "to", " ", "be", " ", "integrated", " ", 
           RowBox[{"out", ".", " ", "we"}], " ", "get", " ", "the", " ", 
           "labels", " ", "of", " ", "all", " ", "new", " ", "particles", " ",
            "from", " ", "topology"}], ",", " ", 
          RowBox[{"so", " ", 
           RowBox[{"{", 
            RowBox[{"p3", ",", "p5", ",", "..."}], "}"}]}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"newparticlelabels", "=", 
         RowBox[{"ToExpression", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"StringJoin", "[", 
             RowBox[{"\"\<p\>\"", ",", 
              RowBox[{"IntegerString", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
           
           RowBox[{"Flatten", "[", 
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"Position", "[", 
               RowBox[{
                RowBox[{"topology", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ",", "\"\<NB\>\""}], "]"}], ",", 
              RowBox[{"Position", "[", 
               RowBox[{
                RowBox[{"topology", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ",", "\"\<NF\>\""}], "]"}]}],
              "]"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"and", " ", "we", " ", "also", " ", "get", " ", "p3bar"}], ",",
          " ", 
         RowBox[{
         "p5bar", " ", "to", " ", "distinguish", " ", "incoming", " ", "and", 
          " ", "outgoing", " ", "internal", " ", 
          RowBox[{"particles", ":"}]}]}], "*)"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"newparticlelabelsbar", "=", 
        RowBox[{"ToExpression", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"StringJoin", "[", 
            RowBox[{"\"\<p\>\"", ",", 
             RowBox[{"IntegerString", "[", "#", "]"}], ",", "\"\<bar\>\""}], 
            "]"}], "&"}], "/@", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{
               RowBox[{"topology", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", "\"\<NB\>\""}], "]"}], ",", 
             RowBox[{"Position", "[", 
              RowBox[{
               RowBox[{"topology", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", "\"\<NF\>\""}], "]"}]}], 
            "]"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "If", " ", "there", " ", "are", " ", "no", " ", "internal", " ", 
          "particles"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"we", "'"}], "re", " ", "looking", " ", "at", " ", "a", " ",
             "simple", " ", "3", " ", "or", " ", "4"}], "-", 
           RowBox[{"particle", " ", "vertex"}]}], ";", " ", 
          RowBox[{"still", " ", "give", " ", "amplitude", " ", "for", " ", 
           RowBox[{"convenience", ":"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
       
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "newparticlelabels", "]"}], "==", "0"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"vertex", "=", "1"}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", 
              RowBox[{
               RowBox[{"topology", "[", 
                RowBox[{"[", "3", "]"}], "]"}], "[", 
               RowBox[{"[", "vertex", "]"}], "]"}], "]"}], "==", "3"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"3", "-", 
              RowBox[{"particle", " ", "vertex"}]}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"inv", "=", 
              RowBox[{
               RowBox[{"Invariants", "[", 
                RowBox[{"group", ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"particles", "[", 
                    RowBox[{"[", 
                    RowBox[{"topology", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "vertex", ",", "1"}], "]"}], "]"}], 
                    "]"}], "]"}], ",", 
                   RowBox[{"particles", "[", 
                    RowBox[{"[", 
                    RowBox[{"topology", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "vertex", ",", "2"}], "]"}], "]"}], 
                    "]"}], "]"}], ",", 
                   RowBox[{"particles", "[", 
                    RowBox[{"[", 
                    RowBox[{"topology", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "vertex", ",", "3"}], "]"}], "]"}], 
                    "]"}], "]"}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"Conjugations", "->", 
                   RowBox[{"{", 
                    RowBox[{"False", ",", "False", ",", "False"}], "}"}]}], 
                  "}"}]}], "]"}], "/.", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"a", "->", 
                  RowBox[{"ToExpression", "[", 
                   RowBox[{
                    RowBox[{"ToString", "[", "p", "]"}], "<>", 
                    RowBox[{"ToString", "[", 
                    RowBox[{"topology", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "vertex", ",", "1"}], "]"}], "]"}], 
                    "]"}]}], "]"}]}], ",", 
                 RowBox[{"b", "->", 
                  RowBox[{"ToExpression", "[", 
                   RowBox[{
                    RowBox[{"ToString", "[", "p", "]"}], "<>", 
                    RowBox[{"ToString", "[", 
                    RowBox[{"topology", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "vertex", ",", "2"}], "]"}], "]"}], 
                    "]"}]}], "]"}]}], ",", 
                 RowBox[{"c", "->", 
                  RowBox[{"ToExpression", "[", 
                   RowBox[{
                    RowBox[{"ToString", "[", "p", "]"}], "<>", 
                    RowBox[{"ToString", "[", 
                    RowBox[{"topology", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "vertex", ",", "3"}], "]"}], "]"}], 
                    "]"}]}], "]"}]}]}], "}"}]}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"MemberQ", "[", 
                RowBox[{"inv", ",", "0"}], "]"}], ",", 
               RowBox[{"Print", "[", 
                RowBox[{"\"\<Vanishing vertex! \>\"", ",", 
                 RowBox[{
                  RowBox[{"topology", "[", 
                   RowBox[{"[", "3", "]"}], "]"}], "[", 
                  RowBox[{"[", "vertex", "]"}], "]"}]}], "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "[", "inv", "]"}], "==", "0"}], ",", 
               RowBox[{"Print", "[", 
                RowBox[{"\"\<Non-existing vertex! \>\"", ",", 
                 RowBox[{
                  RowBox[{"topology", "[", 
                   RowBox[{"[", "3", "]"}], "]"}], "[", 
                  RowBox[{"[", "vertex", "]"}], "]"}]}], "]"}]}], "]"}], 
             ";"}], ",", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"4", "-", 
              RowBox[{"particle", " ", "vertex"}]}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"inv", "=", 
              RowBox[{
               RowBox[{"Invariants", "[", 
                RowBox[{"group", ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"particles", "[", 
                    RowBox[{"[", 
                    RowBox[{"topology", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "vertex", ",", "1"}], "]"}], "]"}], 
                    "]"}], "]"}], ",", 
                   RowBox[{"particles", "[", 
                    RowBox[{"[", 
                    RowBox[{"topology", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "vertex", ",", "2"}], "]"}], "]"}], 
                    "]"}], "]"}], ",", 
                   RowBox[{"particles", "[", 
                    RowBox[{"[", 
                    RowBox[{"topology", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "vertex", ",", "3"}], "]"}], "]"}], 
                    "]"}], "]"}], ",", 
                   RowBox[{"particles", "[", 
                    RowBox[{"[", 
