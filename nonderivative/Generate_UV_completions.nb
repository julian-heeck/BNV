Cell[TextData[{
 "Indeed, there are only two inequivalent UV completions for this QQQL \
operator, in agreement with previous results: nothing but the scalar \
leptoquarks ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7b2a916b-1f80-414b-be91-19df52e1fd0e"],
