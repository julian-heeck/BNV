                  RowBox[{"[", 
                   RowBox[{"topology", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "vertex", ",", "2"}], "]"}], "]"}], 
                   "]"}], "]"}], ",", 
                 RowBox[{"particles", "[", 
                  RowBox[{"[", 
                   RowBox[{"topology", "[", 
                    RowBox[{"[", 
                    RowBox[{"3", ",", "vertex", ",", "3"}], "]"}], "]"}], 
                   "]"}], "]"}]}], "}"}], "/.", " ", 
               "InverseReplaceSMnames"}], ",", 
              RowBox[{"{", 
               RowBox[{"Conjugations", "->", 
                RowBox[{"{", 
                 RowBox[{"False", ",", "False", ",", "False"}], "}"}]}], 
