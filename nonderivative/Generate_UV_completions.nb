    RowBox[{"e", ".", "g", ".", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<F\>\"", ",", "\"\<F\>\"", ",", "\"\<NB\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<F\>\"", ",", "\"\<NF\>\"", ",", "\"\<S\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<F\>\"", ",", "\"\<NF\>\"", ",", "\"\<S\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<NB\>\"", ",", "\"\<NB\>\"", ",", "\"\<S\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<NB\>\"", ",", "\"\<NF\>\"", ",", "\"\<NF\>\""}], "}"}]}],
       "}"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"VertexStructure", "[", 
    RowBox[{"{", 
     RowBox[{"graph_", ",", "first_List", ",", "second_List"}], "}"}], "]"}], 
   ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "mapped", "}"}], ",", 
     RowBox[{
      RowBox[{"mapped", "=", 
       RowBox[{"second", "/.", " ", 
        RowBox[{"i_Integer", ":>", 
         RowBox[{"first", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Sort", "[", 
       RowBox[{"Sort", "/@", "mapped"}], "]"}]}]}], "]"}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "This", " ", "function", " ", "constructs", " ", "a", " ", "directed", " ",
      "graph", " ", "out", " ", "of", " ", "a", " ", "given", " ", "UV", " ", 
     "completion", " ", "so", " ", "that", " ", "all", " ", "internal", " ", 
     "lines", " ", "are", " ", "particles", " ", "rather", " ", "than", " ", 
     "antiparticles", " ", 
     RowBox[{"(", 
      RowBox[{"as", " ", "determined", " ", "by", " ", "RepNaming"}], ")"}]}],
     ",", " ", 
    RowBox[{
     RowBox[{"flipping", " ", "arrows", " ", "as", " ", 
      RowBox[{"needed", ".", " ", "For"}], " ", "self"}], "-", 
     RowBox[{"conjugate", " ", "particles"}]}], ",", " ", 
    RowBox[{"the", " ", "arrow", " ", "is", " ", 
     RowBox[{"removed", ".", " ", "Notice"}], " ", "that", " ", "we", " ", 
     "drop", " ", "chirality", " ", "information", " ", 
     RowBox[{"here", "."}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FullParticleDiagram", "[", "UVComp_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"graph", ",", "particles", ",", "med", ",", "DropChirality"}], 
      "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"DropChirality", "[", "expr_", "]"}], ":=", 
        RowBox[{"expr", " ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
             RowBox[{"Scalar", " ", 
              RowBox[{"(", "S", ")"}]}], ":", 
             RowBox[{"{", "0", "}"}]}], ",", 
            RowBox[{"{", "0", "}"}]}], "*)"}], 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", "0", "}"}], ",", " ", 
              RowBox[{"{", "0", "}"}], ",", " ", "rest___"}], "}"}], " ", ":>",
             " ", 
            RowBox[{"{", 
             RowBox[{"\"\<S\>\"", ",", "rest"}], "}"}]}], ",", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{
              RowBox[{"Fermion", " ", 
               RowBox[{"(", "F", ")"}]}], ":", 
              RowBox[{"{", "0", "}"}]}], ",", 
             RowBox[{
              RowBox[{"{", "1", "}"}], " ", "or", " ", 
              RowBox[{"{", "1", "}"}]}], ",", 
             RowBox[{"{", "0", "}"}]}], "*)"}], 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", "0", "}"}], ",", " ", 
              RowBox[{"{", "1", "}"}], ",", "rest___"}], "}"}], " ", ":>", 
            " ", 
            RowBox[{"{", 
             RowBox[{"\"\<F\>\"", ",", " ", "rest"}], "}"}]}], ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", "1", "}"}], ",", " ", 
              RowBox[{"{", "0", "}"}], ",", " ", "rest___"}], "}"}], " ", ":>",
             " ", 
            RowBox[{"{", 
             RowBox[{"\"\<F\>\"", ",", "rest"}], "}"}]}], ",", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{
              RowBox[{"Vector", " ", 
               RowBox[{"(", "V", ")"}]}], ":", 
              RowBox[{"{", "1", "}"}]}], ",", 
             RowBox[{"{", "1", "}"}]}], "*)"}], 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", "1", "}"}], ",", " ", 
              RowBox[{"{", "1", "}"}], ",", " ", "rest___"}], "}"}], " ", ":>",
             " ", 
            RowBox[{"{", 
             RowBox[{"\"\<V\>\"", ",", " ", "rest"}], "}"}]}]}], "}"}]}]}], 
       ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"basically", " ", "MomentumGraph", " ", "from", " ", 
        RowBox[{"Generate_topologies", ":"}]}], "*)"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"graph", "=", 
       RowBox[{"FixEdgeDirections", "[", 
        RowBox[{
         RowBox[{"MakeDirectedGraph", "[", 
          RowBox[{"UVComp", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"UVComp", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"particles", "=", 
       RowBox[{"DropChirality", "[", 
        RowBox[{"UVComp", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"med", "=", 
         RowBox[{"1", "+", 
          RowBox[{"Count", "[", 
           RowBox[{
            RowBox[{"UVComp", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", 
            RowBox[{"\"\<S\>\"", "|", "\"\<F\>\""}]}], "]"}]}]}], ",", 
        RowBox[{"med", "<=", 
         RowBox[{"Length", "[", "particles", "]"}]}], ",", 
        RowBox[{"med", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Which", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"particles", "[", 
             RowBox[{"[", "med", "]"}], "]"}], "!=", 
            RowBox[{"RepNaming", "[", 
             RowBox[{"particles", "[", 
              RowBox[{"[", "med", "]"}], "]"}], "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"graph", "=", 
             RowBox[{"FlipEdgeByLabel", "[", 
              RowBox[{"graph", ",", "med"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"particles", "[", 
              RowBox[{"[", "med", "]"}], "]"}], "=", 
             RowBox[{"RepNaming", "[", 
              RowBox[{"particles", "[", 
               RowBox[{"[", "med", "]"}], "]"}], "]"}]}], ";"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"ConjugateRep", "[", 
             RowBox[{"particles", "[", 
              RowBox[{"[", "med", "]"}], "]"}], "]"}], "==", 
            RowBox[{"particles", "[", 
             RowBox[{"[", "med", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"graph", "=", 
             RowBox[{"MakeEdgeUndirectedByLabel", "[", 
              RowBox[{"graph", ",", "med"}], "]"}]}], ";"}], ",", 
           "\[IndentingNewLine]", "True", ","}], " ", "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"ToExpression", "[", 
        RowBox[{"StringReplace", "[", 
         RowBox[{
          RowBox[{"ToString", "[", 
           RowBox[{"InputForm", "[", "graph", "]"}], "]"}], ",", 
