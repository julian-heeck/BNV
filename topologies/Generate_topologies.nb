Cell["\<\
These are all possible tree-level graphs with up to three internal lines. The \
code is fast enough to go to much higher number of propagators. In any case, \
one just needs to run it once up to some NumberofPropagators >> 1 and save it \
in a file for future use.\
\>", "Text",
 CellChangeTimes->{{3.936432052802572*^9, 3.936432085528259*^9}, {
   3.93643220628505*^9, 3.9364322208097873`*^9}, {3.936432298403819*^9, 
   3.936432353769067*^9}, 3.936439826346209*^9, {3.9364529498042707`*^9, 
   3.936452950324736*^9}},ExpressionUUID->"762b8d06-dbe0-493e-8467-\
c585fc608861"],

Cell["\<\
In the next step, we use FeynArts (https://feynarts.de/) to thread fermion \
lines through these graphs, so we have to specify the number of external \
fermions and bosons. We will use four fermions and two scalars as an example.
First we load FeynArts, make sure the FeynArts model file \
\[OpenCurlyDoubleQuote]FeynArtsToyModel.mod\[CloseCurlyDoubleQuote] is in the \
notebook directory. It specifies that fermions F and scalars S can only have \
vertices of the form FFS, SSS, SSSS.
Make sure to cite FeynArts/FeynCalc (https://feyncalc.github.io/) \
appropriately when using this code for research.\
\>", "Text",
 CellChangeTimes->{
  3.9364323608644533`*^9, {3.936432412819195*^9, 3.936432511349832*^9}, {
   3.9364326195147038`*^9, 3.936432639797975*^9}, {3.936439912102315*^9, 
   3.936440012397409*^9}, {3.936452905916011*^9, 3.936452933332774*^9}, {
   3.967814240523761*^9, 3.967814241477345*^9}, {3.9678143469972477`*^9, 
   3.967814348207303*^9}},ExpressionUUID->"3dadb58a-e13d-4420-b063-\
ce6ff11f51ae"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"To", " ", "install", " ", 
     RowBox[{"FeynCalc", "/", "FeynArts"}], " ", "in", " ", "Mathematica"}], ",",
     " ", 
    RowBox[{"execute", " ", "the", " ", "following", " ", 
     RowBox[{"commands", ":"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Import", 
     "[", "\"\<https://raw.githubusercontent.com/FeynCalc/feyncalc/master/\
install.m\>\"", "]"}], ";"}], " ", "\n", 
   RowBox[{"InstallFeynCalc", "[", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.93636582874509*^9, 3.936365932759454*^9}, 
   3.936432584333939*^9, 
   3.970582645533621*^9},ExpressionUUID->"a4985809-9bc4-44ad-bbb2-\
7fb283aecf3d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Run", " ", "this", " ", "to", " ", "load", " ", "FeynArts"}], " ",
    "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"description", "=", "\"\<Topology, tree level\>\""}], ";"}], " ", 
   "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"$FrontEnd", "===", "Null"}], ",", 
      RowBox[{
       RowBox[{"$FeynCalcStartupMessages", "=", "False"}], ";", "\n", 
       RowBox[{"Print", "[", "description", "]"}], ";"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"$Notebooks", "===", "False"}], ",", 
      RowBox[{"$FeynCalcStartupMessages", "=", "False"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"$LoadAddOns", "=", 
     RowBox[{"{", "\"\<FeynArts\>\"", "}"}]}], ";"}], " ", "\n", 
   RowBox[{
    RowBox[{"Get", "[", "\"\<FeynCalc`\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"$FAVerbose", "=", "0"}], ";"}]}]}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"d7cf1286-dad4-4d9c-b4f5-4d8216c27474"],

