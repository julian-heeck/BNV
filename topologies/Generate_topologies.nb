 "\nprovide redundant information for the sake of making the UV-completion \
code faster. The entries {\[OpenCurlyDoubleQuote]S\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]S\[CloseCurlyDoubleQuote], \[OpenCurlyDoubleQuote]S\
\[CloseCurlyDoubleQuote], \[OpenCurlyDoubleQuote]F\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]F\[CloseCurlyDoubleQuote], \[OpenCurlyDoubleQuote]F\
\[CloseCurlyDoubleQuote], \[OpenCurlyDoubleQuote]F\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]NB\[CloseCurlyDoubleQuote], \[OpenCurlyDoubleQuote]NF\
\[CloseCurlyDoubleQuote], \[OpenCurlyDoubleQuote]NB\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]NB\[CloseCurlyDoubleQuote]} and {{6, 7, 8}, {5, 8, 9}, \
{4, 9, 10}, {1, 10, 11}, {2, 3, 11}} can be constructed from the graph alone, \
here is a code that does exactly that:"
}], "Text",
 CellChangeTimes->{{3.967838323979349*^9, 3.967838481783654*^9}, {
  3.982570238735395*^9, 
  3.9825702392370157`*^9}},ExpressionUUID->"17dc291d-11c8-44d4-8cf8-\
249534245c10"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Takes", " ", "a", " ", "graph"}], ",", " ", 
    RowBox[{
     RowBox[{"e", ".", "g", ".", " ", "the"}], " ", "first", " ", "entry", " ",
      "of", " ", "a", " ", 
     RowBox[{"UVCompletion", "[", "..", "]"}], " ", "output"}], ",", " ", 
    RowBox[{
    "and", " ", "converts", " ", "it", " ", "into", " ", "the", " ", "full", " ", 
     RowBox[{"topology", ":", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"graph", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<S\>\"", ",", "..", ",", "\"\<F\>\"", ",", "..", 
           ",", "\"\<NF\>\"", ",", "..", ",", "\"\<NB\>\"", ",", ".."}], 
          "}"}], ",", 
         RowBox[{"{", "vertices", "}"}]}], "}"}], "."}]}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ConvertGraphToTopology", "[", "g_Graph", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "edges", ",", "labels", ",", "styles", ",", "classifyEdge", ",", 
        "vertexAdjacency", ",", "vertexStructure"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{"Extract", " ", "edge", " ", "labels"}], "*)"}], 
      RowBox[{
       RowBox[{"labels", "=", 
        RowBox[{"Association", "@", 
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{"PropertyValue", "[", 
            RowBox[{"g", ",", "EdgeLabels"}], "]"}], ",", 
           RowBox[{
            RowBox[{"Rule", "[", 
             RowBox[{
              RowBox[{"UndirectedEdge", "[", 
               RowBox[{"a_", ",", "b_"}], "]"}], ",", 
              RowBox[{"Placed", "[", 
               RowBox[{
                RowBox[{"Text", "[", 
                 RowBox[{"label_", ",", "___"}], "]"}], ",", "___"}], "]"}]}],
              "]"}], ":>", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"UndirectedEdge", "[", 
               RowBox[{"a", ",", "b"}], "]"}], "->", 
              RowBox[{"ToExpression", "[", "label", "]"}]}], ")"}]}], ",", 
           RowBox[{"{", "1", "}"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Extract", " ", "edge", " ", "styles"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"styles", "=", 
        RowBox[{"Association", "@", 
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{"PropertyValue", "[", 
            RowBox[{"g", ",", "EdgeStyle"}], "]"}], ",", 
           RowBox[{
            RowBox[{"Rule", "[", 
             RowBox[{"e_UndirectedEdge", ",", "s_"}], "]"}], ":>", 
            RowBox[{"(", 
             RowBox[{"e", "->", 
              RowBox[{"Flatten", "[", 
               RowBox[{"{", "s", "}"}], "]"}]}], ")"}]}], ",", 
           RowBox[{"{", "1", "}"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Function", " ", "to", " ", "classify", " ", "edges"}], 
        "*)"}], 
       RowBox[{
        RowBox[{"classifyEdge", "[", "e_", "]"}], ":=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"s", "=", 
            RowBox[{"Lookup", "[", 
             RowBox[{"styles", ",", "e", ",", 
              RowBox[{"{", "}"}]}], "]"}]}], "}"}], ",", 
          RowBox[{"Which", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{"s", ",", 
               RowBox[{"GrayLevel", "[", "0", "]"}]}], "]"}], "&&", 
             RowBox[{"!", 
              RowBox[{"MemberQ", "[", 
               RowBox[{"s", ",", 
                RowBox[{"Dashing", "[", 
                 RowBox[{"{", 
                  RowBox[{"Small", ",", "Small"}], "}"}], "]"}]}], "]"}]}]}], 
            ",", "\"\<F\>\"", ",", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{"s", ",", 
               RowBox[{"GrayLevel", "[", "0", "]"}]}], "]"}], "&&", 
             RowBox[{"MemberQ", "[", 
              RowBox[{"s", ",", 
               RowBox[{"Dashing", "[", 
                RowBox[{"{", 
                 RowBox[{"Small", ",", "Small"}], "}"}], "]"}]}], "]"}]}], 
            ",", "\"\<S\>\"", ",", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{"s", ",", 
               RowBox[{"RGBColor", "[", 
                RowBox[{"1", ",", "0", ",", "0"}], "]"}]}], "]"}], "&&", 
             RowBox[{"!", 
              RowBox[{"MemberQ", "[", 
               RowBox[{"s", ",", 
                RowBox[{"Dashing", "[", 
                 RowBox[{"{", 
                  RowBox[{"Small", ",", "Small"}], "}"}], "]"}]}], "]"}]}]}], 
            ",", "\"\<NF\>\"", ",", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{"s", ",", 
               RowBox[{"RGBColor", "[", 
                RowBox[{"1", ",", "0", ",", "0"}], "]"}]}], "]"}], "&&", 
             RowBox[{"MemberQ", "[", 
              RowBox[{"s", ",", 
               RowBox[{"Dashing", "[", 
                RowBox[{"{", 
                 RowBox[{"Small", ",", "Small"}], "}"}], "]"}]}], "]"}]}], 
            ",", "\"\<NB\>\"", ",", "True", ",", "\"\<Unknown\>\""}], "]"}]}],
          "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Extract", " ", "and", " ", "sort", " ", "edges", " ", "by", " ", 
         "label"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"edges", "=", 
        RowBox[{"SortBy", "[", 
         RowBox[{
          RowBox[{"Keys", "[", "labels", "]"}], ",", "labels"}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Build", " ", "vertex", " ", "adjacency", " ", "structure", " ", 
         "correctly"}], "*)"}], 
       RowBox[{"vertexAdjacency", "=", 
        RowBox[{"GroupBy", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"Keys", "[", "labels", "]"}], "/.", " ", 
            RowBox[{
             RowBox[{"UndirectedEdge", "[", 
              RowBox[{"a_", ",", "b_"}], "]"}], ":>", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"a", "->", 
                RowBox[{"labels", "[", 
                 RowBox[{"UndirectedEdge", "[", 
                  RowBox[{"a", ",", "b"}], "]"}], "]"}]}], ",", 
               RowBox[{"b", "->", 
                RowBox[{"labels", "[", 
                 RowBox[{"UndirectedEdge", "[", 
                  RowBox[{"a", ",", "b"}], "]"}], "]"}]}]}], "}"}]}]}], "]"}],
           ",", 
          RowBox[{"First", "->", "Last"}], ",", "Union"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Extract", " ", "only", " ", "unique", " ", "sorted", " ", "lists", " ",
          "of", " ", "edge", " ", "labels", " ", "where", " ", "vertices", " ",
          "share", " ", "multiple", " ", "edges"}], "*)"}], 
       RowBox[{"vertexStructure", "=", 
        RowBox[{"SortBy", "[", 
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"Values", "[", "vertexAdjacency", "]"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "#", "]"}], ">", "1"}], "&"}]}], "]"}], ",",
           "Last"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Return", " ", "full", " ", "structure"}], "*)"}], 
       RowBox[{"{", 
        RowBox[{"g", ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"classifyEdge", "[", "e", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"e", ",", "edges"}], "}"}]}], "]"}], ",", 
         "vertexStructure"}], "}"}]}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.95053011679807*^9, 3.950530116800622*^9}, {
   3.950533997309999*^9, 3.950533997923812*^9}, {3.950534556228709*^9, 
