Cell["\<\
Et voila, all topologically inequivalent tree-level Feynman diagrams with two \
external bosons and four external fermions.\
\>", "Text",
 CellChangeTimes->{{3.936433282766797*^9, 3.9364333880136223`*^9}, 
   3.93644058291245*^9, {3.9364412773980923`*^9, 3.936441278029352*^9}, {
   3.93644134790344*^9, 3.936441348622985*^9}, {3.9364531720826674`*^9, 
   3.936453180082389*^9}},ExpressionUUID->"5629481a-0ccb-4e79-9321-\
4f2a1c5e7172"]
}, Closed]],

Cell[CellGroupData[{

Cell["Particle numbering", "Section",
 CellChangeTimes->{{3.936433448290282*^9, 
  3.93643346544841*^9}},ExpressionUUID->"fb50cc4b-5b63-44ff-afcd-\
a4324f85f1a1"],

Cell[TextData[{
 "For our UV completion code, it is useful to extract some information from \
each diagram and store it together with the graph. For one, we collect \
whether particle 1, 2, 3, etc are external scalars (S), external fermions \
(F), internal new bosons (NB), or internal new fermions (NF). Second, we \
collect which particles meet at each vertex. For example, for ",
 Cell[BoxData[
  GraphicsBox[
   NamespaceBox["NetworkGraphics",
    DynamicModuleBox[{Typeset`graph = HoldComplete[
      Graph[{
       "Vertex[1][5]", "Vertex[3][6]", "Vertex[1][6]", "Vertex[1][3]", 
        "Vertex[3][5]", "Vertex[1][4]"}, {
       Null, {{1, 2}, {3, 2}, {4, 5}, {6, 5}, {2, 5}}}, {
       EdgeLabels -> {UndirectedEdge["Vertex[3][6]", "Vertex[3][5]"] -> Placed[
            Text["5", Background -> {
               GrayLevel[1]}], {Left, "Middle"}], 
          UndirectedEdge["Vertex[1][3]", "Vertex[3][5]"] -> Placed[
            Text["3", Background -> {
               GrayLevel[1]}], {Left, "Middle"}], 
          UndirectedEdge["Vertex[1][5]", "Vertex[3][6]"] -> Placed[
            Text["1", Background -> {
               GrayLevel[1]}], {Left, "Middle"}], 
          UndirectedEdge["Vertex[1][4]", "Vertex[3][5]"] -> Placed[
            Text["4", Background -> {
               GrayLevel[1]}], {Left, "Middle"}], 
          UndirectedEdge["Vertex[1][6]", "Vertex[3][6]"] -> Placed[
            Text["2", Background -> {
               GrayLevel[1]}], {Left, "Middle"}]}, 
        EdgeStyle -> {UndirectedEdge["Vertex[3][6]", "Vertex[3][5]"] -> {
            RGBColor[1, 0, 0], 
            Dashing[{Small, Small}]}, 
          UndirectedEdge["Vertex[1][6]", "Vertex[3][6]"] -> {
            GrayLevel[0], 
            Dashing[{Small, Small}]}, 
          UndirectedEdge["Vertex[1][3]", "Vertex[3][5]"] -> GrayLevel[0], 
          UndirectedEdge["Vertex[1][4]", "Vertex[3][5]"] -> GrayLevel[0], 
          UndirectedEdge["Vertex[1][5]", "Vertex[3][6]"] -> {
            GrayLevel[0], 
            Dashing[{Small, Small}]}}}]]}, 
     TagBox[GraphicsGroupBox[{
        {Hue[0.6, 0.7, 0.5], Opacity[0.7], {
          {GrayLevel[0], Dashing[{Small, Small}], 
           {Arrowheads[0.], 
            ArrowBox[{{0., 0.8164965809277261}, {0.8164965809277261, 
             1.6329931618554523`}}, 0.022945218072026957`]}}, InsetBox[
           InterpretationBox[Cell[BoxData[
             FormBox["\<\"1\"\>", TextForm]], "InlineText",
             Background->{
               GrayLevel[1]},ExpressionUUID->
             "dccbfb33-de90-48fc-8a32-19806f08941d"],
            Text["1", Background -> {
               GrayLevel[1]}]], 
           Offset[{-2., 0.}, {0.4082482904638631, 1.2247448713915892}], 
           ImageScaled[{1., 0.5}],
           BaseStyle->"Graphics"]}, {
          {GrayLevel[0], Dashing[{Small, Small}], 
           {Arrowheads[0.], 
            ArrowBox[{{0.8164965809277261, 1.6329931618554523`}, {
             0.8164965809277261, 0.8164965809277261}}, 
             0.022945218072026957`]}}, InsetBox[
           InterpretationBox[Cell[BoxData[
             FormBox["\<\"2\"\>", TextForm]], "InlineText",
             Background->{
               GrayLevel[1]},ExpressionUUID->
             "d685e409-910a-4478-94b6-32d907616d55"],
            Text["2", Background -> {
               GrayLevel[1]}]], 
           Offset[{-2., 0.}, {0.8164965809277261, 1.2247448713915892}], 
           ImageScaled[{1., 0.5}],
           BaseStyle->"Graphics"]}, {
          {RGBColor[1, 0, 0], Dashing[{Small, Small}], 
           {Arrowheads[0.], 
            ArrowBox[{{0.8164965809277261, 1.6329931618554523`}, {
             1.6329931618554523`, 0.8164965809277261}}, 
             0.022945218072026957`]}}, InsetBox[
           InterpretationBox[Cell[BoxData[
             FormBox["\<\"5\"\>", TextForm]], "InlineText",
             Background->{
               GrayLevel[1]},ExpressionUUID->
             "f80cc4f2-d3f3-4d99-81e4-8f8390b51658"],
            Text["5", Background -> {
               GrayLevel[1]}]], 
           Offset[{-2., 0.}, {1.2247448713915892, 1.2247448713915892}], 
           ImageScaled[{1., 0.5}],
           BaseStyle->"Graphics"]}, {
          {GrayLevel[0], 
           {Arrowheads[0.], 
            ArrowBox[{{1.2247448713915892`, 0.}, {1.6329931618554523`, 
             0.8164965809277261}}, 0.022945218072026957`]}}, InsetBox[
           InterpretationBox[Cell[BoxData[
             FormBox["\<\"3\"\>", TextForm]], "InlineText",
             Background->{
               GrayLevel[1]},ExpressionUUID->
             "dcc4d1ea-c143-4416-8559-1a2cdcc34b42"],
            Text["3", Background -> {
               GrayLevel[1]}]], 
           Offset[{-2., 0.}, {1.4288690166235207, 0.4082482904638631}], 
           ImageScaled[{1., 0.5}],
           BaseStyle->"Graphics"]}, {
          {GrayLevel[0], 
           {Arrowheads[0.], 
            ArrowBox[{{1.6329931618554523`, 0.8164965809277261}, {
             2.041241452319315, 0.}}, 0.022945218072026957`]}}, InsetBox[
           InterpretationBox[Cell[BoxData[
             FormBox["\<\"4\"\>", TextForm]], "InlineText",
             Background->{
               GrayLevel[1]},ExpressionUUID->
             "d2570cd3-9618-4929-bf62-c518c064f241"],
            Text["4", Background -> {
               GrayLevel[1]}]], 
           Offset[{-2., 0.}, {1.8371173070873836, 0.4082482904638631}], 
           ImageScaled[{1., 0.5}],
           BaseStyle->"Graphics"]}}, 
        {Hue[0.6, 0.2, 0.8], EdgeForm[{GrayLevel[0], Opacity[0.7]}], 
         DiskBox[{0., 0.8164965809277261}, 0.022945218072026957], 
         DiskBox[{0.8164965809277261, 1.6329931618554523`}, 
          0.022945218072026957], 
         DiskBox[{0.8164965809277261, 0.8164965809277261}, 
          0.022945218072026957], 
         DiskBox[{1.2247448713915892`, 0.}, 0.022945218072026957], 
         DiskBox[{1.6329931618554523`, 0.8164965809277261}, 
          0.022945218072026957], 
         DiskBox[{2.041241452319315, 0.}, 0.022945218072026957]}}],
      MouseAppearanceTag["NetworkGraphics"]],
     AllowKernelInitialization->False]],
   DefaultBaseStyle->"NetworkGraphics",
   FormatType->TraditionalForm,
   FrameTicks->None,
   ImageSize->{75.00000000000023, Automatic}]], "Output",
  CellChangeTimes->{{3.936440897007415*^9, 3.936440908250908*^9}},
  ExpressionUUID->"6db54da9-7976-485e-b586-ea07257fc81c"],
 " we collect the vertex structure {{1, 2, 5}, {3, 4, 5}} that tells us that \
particles 1,2, and 5 meet at one vertex, and 3, 4 and 5 meet at another. Any \
particle number that only occurs once in this list is an external particle, \
every particle number that occurs twice is an internal particle."
}], "Text",
 CellChangeTimes->{{3.936440829862507*^9, 3.936440863782628*^9}, {
  3.9364409153902197`*^9, 3.936441025636506*^9}, {3.936441058105534*^9, 
  3.9364411550857162`*^9}},ExpressionUUID->"259b1d0a-979f-4869-9b73-\
e59f8a21e2c2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "This", " ", "code", " ", "processes", " ", "a", " ", "list", " ", "of", " ",
      "irreducible", " ", "diagrams", " ", 
     RowBox[{"(", "\"\<irred\>\"", ")"}]}], ",", " ", 
    RowBox[{
    "reindexes", " ", "the", " ", "edges", " ", "and", " ", "classifies", " ",
      "particles", " ", "in", " ", "each", " ", "diagram"}]}], " ", "*)"}], 
  "\n", 
  RowBox[{"Flist", "=", 
   RowBox[{"ParallelTable", "[", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"irreddiagram", "=", 
       RowBox[{"irred", "[", 
        RowBox[{"[", "s", "]"}], "]"}]}], ";", "\n", 
      RowBox[{"vertices", "=", 
       RowBox[{"{", "}"}]}], ";", "\n", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"n", "=", "1"}], ",", 
        RowBox[{"n", "<=", 
         RowBox[{"Length", "[", 
          RowBox[{"VertexList", "[", 
           RowBox[{"irreddiagram", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], ",", 
        RowBox[{"n", "++"}], ",", "\n", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "Checking", " ", "whether", " ", "the", " ", "vertex", " ", 
           "represents", " ", "an", " ", "interaction", " ", "with", " ", 
           "more", " ", "than", " ", "two", " ", 
           RowBox[{"particles", ".", " ", "If"}], " ", "this", " ", "is", " ",
            "true"}], ",", " ", 
          RowBox[{"it", " ", "processes", " ", "that", " ", 
           RowBox[{"vertex", "."}]}]}], " ", "*)"}], "\n", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"ToExpression", "[", 
             RowBox[{"VertexList", "[", 
              RowBox[{"irreddiagram", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"n", ",", "0", ",", "1"}], "]"}], "]"}], ">", "2"}], ",",
           "\n", 
          RowBox[{
           RowBox[{"vertex", "=", 
            RowBox[{"{", "}"}]}], ";", "\n", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"m", "=", "1"}], ",", 
             RowBox[{"m", "<=", 
              RowBox[{"Length", "[", 
               RowBox[{"EdgeList", "[", 
                RowBox[{"irreddiagram", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], ",", 
             RowBox[{"m", "++"}], ",", "\n", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"EdgeList", "[", 
                    RowBox[{"irreddiagram", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "[", 
                   RowBox[{"[", "m", "]"}], "]"}], "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "==", 
                 RowBox[{
                  RowBox[{"VertexList", "[", 
                   RowBox[{"irreddiagram", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "[", 
                  RowBox[{"[", "n", "]"}], "]"}]}], "||", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"EdgeList", "[", 
                    RowBox[{"irreddiagram", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "[", 
                   RowBox[{"[", "m", "]"}], "]"}], "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "==", 
                 RowBox[{
                  RowBox[{"VertexList", "[", 
                   RowBox[{"irreddiagram", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "[", 
                  RowBox[{"[", "n", "]"}], "]"}]}]}], ",", "\n", 
               RowBox[{
                RowBox[{"AppendTo", "[", 
                 RowBox[{"vertex", ",", 
                  RowBox[{
                   RowBox[{"EdgeList", "[", 
                    RowBox[{"irreddiagram", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "[", 
                   RowBox[{"[", "m", "]"}], "]"}]}], "]"}], ";"}]}], "\n", 
              "]"}]}], "\n", "]"}], ";", "\n", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "vertex", "]"}], ">", "0"}], ",", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"vertices", ",", "vertex"}], "]"}]}], "]"}]}]}], "\n", 
         "]"}]}], "\n", "]"}], ";", "\n", 
      RowBox[{"(*", " ", 
       RowBox[{
       "classify", " ", "the", " ", "particles", " ", "and", " ", "sort", " ",
         "the", " ", "vertices", " ", "by", " ", "their", " ", "second", " ", 
        "to", " ", "last", " ", "element"}], " ", "*)"}], "\n", 
      RowBox[{"Vertx", "=", 
       RowBox[{"vertices", "/.", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"EdgeList", "[", 
             RowBox[{"irreddiagram", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}], "[", 
            RowBox[{"[", "k", "]"}], "]"}], "->", "k"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "1", ",", 
            RowBox[{"Length", "[", 
             RowBox[{"EdgeList", "[", 
              RowBox[{"irreddiagram", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], "}"}]}], 
         "]"}]}]}], ";", "\n", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"irreddiagram", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{"irreddiagram", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "2"}], "]"}], "]"}], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "->", "\"\<F\>\""}], ",", 
           RowBox[{"2", "->", "\"\<S\>\""}], ",", 
           RowBox[{"3", "->", "\"\<NF\>\""}], ",", 
           RowBox[{"4", "->", "\"\<NB\>\""}]}], "}"}]}], ",", 
        RowBox[{"Sort", "/@", 
         RowBox[{"SortBy", "[", 
          RowBox[{"Vertx", ",", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"-", "2"}], "]"}], "]"}], "&"}]}], "]"}]}]}], "}"}]}], ",",
      "\n", 
     RowBox[{"{", 
      RowBox[{"s", ",", "1", ",", 
       RowBox[{"Length", "[", "irred", "]"}]}], "}"}]}], "]"}]}]}]], "Input",
