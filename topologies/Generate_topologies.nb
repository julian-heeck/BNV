Cell[TextData[{
 "First define incoming particles and put in the list, F[1] and S[1] \
represents fermion and scalar. Our convention is to always ",
 StyleBox["list scalars first",
  FontWeight->"Bold"],
 "."
}], "Text",
 CellChangeTimes->{{3.936432666515785*^9, 3.9364326686857443`*^9}, {
  3.973868317615204*^9, 
  3.973868361299707*^9}},ExpressionUUID->"c4fa6cbd-eaa1-4d2b-a6b5-\
97e4e91d1cdd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ListofincomingParticles", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"S", "[", "1", "]"}], ",", 
     RowBox[{"S", "[", "1", "]"}], ",", 
     RowBox[{"F", "[", "1", "]"}], ",", 
     RowBox[{"F", "[", "1", "]"}], ",", 
     RowBox[{"F", "[", "1", "]"}], ",", 
     RowBox[{"F", "[", "1", "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"NumberofExternalParticles", "=", 
   RowBox[{"Length", "[", "ListofincomingParticles", "]"}]}], ";"}]}], "Input",\

 CellLabel->"In[12]:=",ExpressionUUID->"06e5e699-d7a8-496c-aff4-5a5cb51b94bc"],

Cell["\<\
Then we pick all graphs in \[OpenCurlyDoubleQuote]props\
\[CloseCurlyDoubleQuote] that have six external particles and store them in \
\[OpenCurlyDoubleQuote]topology\[CloseCurlyDoubleQuote]:\
\>", "Text",
 CellChangeTimes->{{3.93643269954653*^9, 3.936432730410855*^9}, {
  3.936452992989044*^9, 
  3.936452998157483*^9}},ExpressionUUID->"1093b105-7e10-47f0-a366-\
36c2879b706b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"NumberOfExternalParticles", "[", "graph_", "]"}], ":=", 
  RowBox[{"Count", "[", 
   RowBox[{
    RowBox[{"VertexDegree", "[", "graph", "]"}], ",", "1"}], "]"}]}], "\n", 
 RowBox[{"topology", "=", 
  RowBox[{"Select", "[", 
   RowBox[{"props", ",", 
    RowBox[{
     RowBox[{
      RowBox[{"NumberOfExternalParticles", "[", "#", "]"}], "==", 
      "NumberofExternalParticles"}], "&"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{3.936432805212398*^9},
 CellLabel->"In[14]:=",ExpressionUUID->"b3441885-4e35-4b02-b159-9498bdf8cbbe"],

