      DefaultBaseStyle->"NetworkGraphics",
      FormatType->TraditionalForm,
      FrameTicks->None], ",", 
     RowBox[{"{", 
      RowBox[{"\<\"S\"\>", ",", "\<\"S\"\>", ",", "\<\"S\"\>", 
       ",", "\<\"F\"\>", ",", "\<\"F\"\>", ",", "\<\"F\"\>", ",", "\<\"F\"\>",
        ",", "\<\"NF\"\>", ",", "\<\"NB\"\>", ",", "\<\"NB\"\>", 
       ",", "\<\"NB\"\>"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "3", ",", "11"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"6", ",", "7", ",", "9"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"4", ",", "8", ",", "10"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"5", ",", "8", ",", "9"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "10", ",", "11"}], "}"}]}], "}"}]}], "}"}], 
   TraditionalForm]], "Output",
  GeneratedCell->False,
  CellAutoOverwrite->False,
  CellChangeTimes->{{3.936451545123313*^9, 3.936451568217072*^9}, 
    3.936451621044874*^9},ExpressionUUID->
  "1e81070e-a1b6-4858-ad0b-e769f6d76d06"],
 "\nOur UV completion code would start with the first vertex and multiply \
particles 2 and 3 together to get the quantum numbers of particle 11. So far, \
so good. The second vertex gives us the quantum numbers of particle 9, also \
fine. But the third vertex {4,8,10} contains only one known particle (4) and \
two unknowns (8 & 10). In order to allow our code to sequentially go through \
the vertex list without this happening, we will swap particle numbers until \
our desired ordering is achieved. \n\nThe following code swaps particle \
numbers in a graph, in the {S,S,..., F,F,.. NB,..NF} list, and in the vertex \
list {{A,B,C},{..},{...}}. Notice that our labeling/sorting is not unique."
}], "Text",
 CellChangeTimes->{{3.936441390135734*^9, 3.936441433064309*^9}, {
   3.936441481219298*^9, 3.9364416173295507`*^9}, {3.936451785146474*^9, 
   3.936452023788508*^9}, {3.936452208751697*^9, 3.936452391726883*^9}, {
   3.936452598887849*^9, 3.9364526245420427`*^9}, 3.936453276543324*^9, 
   3.936453583205043*^9, {3.967814092067897*^9, 3.967814096455598*^9}, {
   3.973868879765863*^9, 3.973868979106637*^9}, {3.9825701414764214`*^9, 
   3.982570154233335*^9}},ExpressionUUID->"e88b7798-f42f-46c1-ab19-\
feda8bc373af"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"label", "[", "i_", "]"}], ":=", 
   RowBox[{"Placed", "[", 
    RowBox[{
     RowBox[{"Text", "[", 
      RowBox[{
       RowBox[{"ToString", "[", "i", "]"}], ",", 
       RowBox[{"Background", "->", "White"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"Left", ",", "\"\<Middle\>\""}], "}"}]}], "]"}]}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "code", " ", "that", " ", "swaps", " ", "particles", " ", "x", " ", "and",
      " ", "y", " ", "in", " ", "diagram"}], ",", " ", 
    RowBox[{"spin", " ", "list"}], ",", " ", 
    RowBox[{"and", " ", "vertex", " ", 
     RowBox[{"list", ":"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"swap", "[", 
   RowBox[{"list_", ",", "x_", ",", "x_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"list", "[", 
     RowBox[{"[", "1", "]"}], "]"}], ",", 
    RowBox[{"list", "[", 
     RowBox[{"[", "2", "]"}], "]"}], ",", 
    RowBox[{"SortBy", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"SortBy", "[", 
         RowBox[{"#", ",", "Abs"}], "]"}], "&"}], "/@", 
       RowBox[{"list", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], ",", 
      RowBox[{"N", "@*", "Last"}]}], "]"}]}], "}"}]}], "\n", 
 RowBox[{
  RowBox[{"swap", "[", 
   RowBox[{"list_", ",", "x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"IGEdgeMap", "[", 
     RowBox[{
      RowBox[{"Replace", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"label", "[", "x", "]"}], "->", 
          RowBox[{"label", "[", "y", "]"}]}], ",", 
         RowBox[{
          RowBox[{"label", "[", "y", "]"}], "->", 
          RowBox[{"label", "[", "x", "]"}]}]}], "}"}], "]"}], ",", 
      "EdgeLabels", ",", 
      RowBox[{"list", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
    RowBox[{"Permute", "[", 
     RowBox[{
      RowBox[{"list", "[", 
       RowBox[{"[", "2", "]"}], "]"}], ",", 
      RowBox[{"Cycles", "[", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}], "}"}], "]"}]}], "]"}], ",", 
    RowBox[{"SortBy", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"SortBy", "[", 
         RowBox[{"#", ",", "Abs"}], "]"}], "&"}], "/@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"list", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "/.", 
           RowBox[{"(", 
            RowBox[{"x", "->", "temp"}], ")"}]}], "/.", 
          RowBox[{"(", 
           RowBox[{"y", "->", "x"}], ")"}]}], "/.", 
         RowBox[{"(", 
          RowBox[{"temp", "->", "y"}], ")"}]}], ")"}]}], ",", 
      RowBox[{"N", "@*", "Last"}]}], "]"}]}], "}"}]}], "\n", 
 RowBox[{
  RowBox[{"SortDiagram", "[", "list_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"templist", "=", 
       RowBox[{"swap", "[", 
        RowBox[{"list", ",", "1", ",", "1"}], "]"}]}], 
      RowBox[{"(*", 
       RowBox[{
       "make", " ", "sure", " ", "input", " ", "has", " ", "properly", " ", 
        "sorted", " ", "vertex", " ", "list"}], "*)"}], ",", 
      "NumberOfExternal", ",", "NumberOfInternal", ",", "mismatch", ",", 
      "swap1", ",", "swap2", ",", "goal", ",", 
      RowBox[{"NumberOfSwaps", "=", "0"}]}], "}"}], ",", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"NumberOfInternal", "=", 
        RowBox[{
         RowBox[{"Count", "[", 
          RowBox[{
           RowBox[{"list", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "\"\<NB\>\""}], "]"}], "+", 
         RowBox[{"Count", "[", 
          RowBox[{
           RowBox[{"list", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "\"\<NF\>\""}], "]"}]}]}], ";",
        "\n", 
       RowBox[{"NumberOfExternal", "=", 
        RowBox[{
         RowBox[{"Count", "[", 
          RowBox[{
           RowBox[{"list", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "\"\<S\>\""}], "]"}], "+", 
         RowBox[{"Count", "[", 
          RowBox[{
           RowBox[{"list", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "\"\<F\>\""}], "]"}]}]}], 
       ";"}], "\n", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Sort", " ", "everything", " ", "so", " ", "that", " ", 
         RowBox[{
          RowBox[{"list", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "3"}], "]"}], "]"}], " ", "looks", " ", "like",
          " ", 
         RowBox[{"{", 
          RowBox[{
          "8", ",", "9", ",", "10", ",", "11", ",", "...", ",", "20", ",", 
           "21", ",", "22", ",", "22"}], "}"}]}], ",", " ", 
        RowBox[{
        "so", " ", "the", " ", "goal", " ", "is", " ", "to", " ", "reach", " ",
          "this", " ", 
         RowBox[{"list", ":"}]}]}], "*)"}], ";", "\n", 
      RowBox[{"goal", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"NumberOfExternal", "+", "1"}], ",", 
           RowBox[{"NumberOfExternal", "+", "NumberOfInternal"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"NumberOfExternal", "+", "NumberOfInternal"}], "}"}]}], 
        "]"}]}], ";"}], "\n", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "mismatch", " ", "is", " ", "how", " ", "far", " ", "away", " ", "we", 
        " ", "are", " ", "from", " ", "the", " ", "goal"}], ",", " ", 
       RowBox[{
        RowBox[{"i", ".", "e", ".", " ", "which"}], " ", "internal", " ", 
        "particles", " ", "are", " ", "not", " ", "in", " ", "place"}]}], 
      "*)"}], ";", "\n", 
     RowBox[{"mismatch", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"Fold", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"DeleteCases", "[", 
            RowBox[{"##", ",", "1", ",", "1"}], "]"}], "&"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Last", "[", "#", "]"}], "&"}], "/@", 
           RowBox[{"templist", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ",", "goal"}], "]"}], ",", 
        RowBox[{"Fold", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"DeleteCases", "[", 
            RowBox[{"##", ",", "1", ",", "1"}], "]"}], "&"}], ",", "goal", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Last", "[", "#", "]"}], "&"}], "/@", 
           RowBox[{"templist", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}]}], "]"}]}], "]"}]}], ";", "\n", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "mismatch", "]"}], "!=", "0"}], ",", "\n", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "of", " ", "all", " ", "the", " ", "mismatched", " ", "particles"}], 
         ",", " ", 
         RowBox[{
         "pick", " ", "two", " ", "at", " ", "random", " ", "to", " ", 
          "switch", " ", "around", " ", "and", " ", "then", " ", 
          RowBox[{"repeat", ".", " ", "Random"}], " ", "so", " ", "that", " ",
           "we", " ", "never", " ", "end", " ", "up", " ", "in", " ", "a", " ",
           "loop", " ", "where", " ", "we", " ", "switch", " ", "the", " ", 
          "same", " ", "two", " ", "particles", " ", "around", " ", "without",
           " ", "changing", " ", 
          RowBox[{"anything", "."}]}]}], "*)"}], "\n", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"swap1", ",", "swap2"}], "}"}], "=", 
          RowBox[{"RandomSample", "[", 
           RowBox[{"mismatch", ",", "2"}], "]"}]}], ";", "\n", 
         RowBox[{"templist", "=", 
          RowBox[{"swap", "[", 
           RowBox[{"templist", ",", "swap1", ",", "swap2"}], "]"}]}], ";", 
         "\n", 
         RowBox[{"mismatch", "=", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"Fold", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"DeleteCases", "[", 
                RowBox[{"##", ",", "1", ",", "1"}], "]"}], "&"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Last", "[", "#", "]"}], "&"}], "/@", 
               RowBox[{"templist", "[", 
                RowBox[{"[", "3", "]"}], "]"}]}], ",", "goal"}], "]"}], ",", 
            RowBox[{"Fold", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"DeleteCases", "[", 
                RowBox[{"##", ",", "1", ",", "1"}], "]"}], "&"}], ",", "goal",
               ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Last", "[", "#", "]"}], "&"}], "/@", 
               RowBox[{"templist", "[", 
                RowBox[{"[", "3", "]"}], "]"}]}]}], "]"}]}], "]"}]}], ";", 
         "\n", 
         RowBox[{"NumberOfSwaps", "++"}], ";"}], "\n", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "If", " ", "I", " ", "ever", " ", "need", " ", "more", " ", "than", 
           " ", "a", " ", "100", " ", "swaps", " ", "something", " ", "is", " ",
            "wrong"}], ",", " ", 
          RowBox[{
          "so", " ", "this", " ", "breaks", " ", "the", " ", "infinity", " ", 
           
           RowBox[{"loop", ":"}]}]}], "*)"}], ";", "\n", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"NumberOfSwaps", ">=", "100"}], ",", 
          RowBox[{
           RowBox[{"Print", "[", "\"\<Can't sort this!\>\"", "]"}], ";", 
           RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}]}]}], "\n", "]"}], ";", 
     "\n", "templist"}]}], "\n", "]"}]}]}], "Input",
 CellChangeTimes->{3.9725082526551437`*^9, 
  3.9738682708957777`*^9},ExpressionUUID->"004b13dd-73ea-4338-a5c3-\
9a2f73a5f94c"],

Cell["\<\
And now we apply it to our previously generated list \
\[OpenCurlyDoubleQuote]Flist\[CloseCurlyDoubleQuote]:\
\>", "Text",
