Cell[TextData[{
 "For our UV completion code, it is convenient to ensure the following \
particle numbering: \nlabel the incoming particles and propagators such that \
each n-particle vertex {A[1],A[2],...,A[n]} contains n-1 ",
 StyleBox["known",
  FontSlant->"Italic"],
 " fields A[1],...,A[n-1], so either external fields or internal fields that \
have already appeared at a previous vertex. \nThis allows us to \
systematically go through the list of vertices and only have at most one \
unknown (internal) particle A[n].\nIn some cases, this numbering comes out \
automatically, but this is not always the case. Take for example this \
four-fermion three-scalar diagram\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     GraphicsBox[
      NamespaceBox["NetworkGraphics",
       DynamicModuleBox[{Typeset`graph = HoldComplete[
         Graph[{
          "Vertex[1][8]", "Vertex[3][7]", "Vertex[1][11]", "Vertex[3][11]", 
           "Vertex[1][12]", "Vertex[1][4]", "Vertex[3][5]", "Vertex[1][6]", 
           "Vertex[3][6]", "Vertex[1][9]", "Vertex[3][9]", "Vertex[1][10]"}, {
          Null, {{1, 2}, {3, 4}, {5, 4}, {6, 7}, {8, 9}, {10, 11}, {12, 11}, {
           9, 7}, {9, 11}, {2, 7}, {2, 4}}}, {
          EdgeLabels -> {
            UndirectedEdge["Vertex[1][4]", "Vertex[3][5]"] -> Placed[
               Text["4", Background -> GrayLevel[1]], {Left, "Middle"}], 
             UndirectedEdge["Vertex[1][8]", "Vertex[3][7]"] -> Placed[
               Text["1", Background -> GrayLevel[1]], {Left, "Middle"}], 
             UndirectedEdge["Vertex[1][10]", "Vertex[3][9]"] -> Placed[
               Text["7", Background -> GrayLevel[1]], {Left, "Middle"}], 
             UndirectedEdge["Vertex[1][6]", "Vertex[3][6]"] -> Placed[
               Text["5", Background -> GrayLevel[1]], {Left, "Middle"}], 
             UndirectedEdge["Vertex[3][7]", "Vertex[3][11]"] -> Placed[
               Text["11", Background -> GrayLevel[1]], {Left, "Middle"}], 
             UndirectedEdge["Vertex[3][6]", "Vertex[3][9]"] -> Placed[
               Text["9", Background -> GrayLevel[1]], {Left, "Middle"}], 
             UndirectedEdge["Vertex[1][12]", "Vertex[3][11]"] -> Placed[
               Text["3", Background -> GrayLevel[1]], {Left, "Middle"}], 
             UndirectedEdge["Vertex[1][9]", "Vertex[3][9]"] -> Placed[
               Text["6", Background -> GrayLevel[1]], {Left, "Middle"}], 
             UndirectedEdge["Vertex[1][11]", "Vertex[3][11]"] -> Placed[
               Text["2", Background -> GrayLevel[1]], {Left, "Middle"}], 
             UndirectedEdge["Vertex[3][7]", "Vertex[3][5]"] -> Placed[
               Text["10", Background -> GrayLevel[1]], {Left, "Middle"}], 
             UndirectedEdge["Vertex[3][6]", "Vertex[3][5]"] -> Placed[
               Text["8", Background -> GrayLevel[1]], {Left, "Middle"}]}, 
           EdgeStyle -> {UndirectedEdge["Vertex[3][6]", "Vertex[3][9]"] -> {
               RGBColor[1, 0, 0], 
               Dashing[{Small, Small}]}, 
             UndirectedEdge["Vertex[3][7]", "Vertex[3][11]"] -> {
               RGBColor[1, 0, 0], 
               Dashing[{Small, Small}]}, 
             UndirectedEdge["Vertex[3][6]", "Vertex[3][5]"] -> 
             RGBColor[1, 0, 0], 
             UndirectedEdge["Vertex[3][7]", "Vertex[3][5]"] -> {
               RGBColor[1, 0, 0], 
               Dashing[{Small, Small}]}, 
             UndirectedEdge["Vertex[1][4]", "Vertex[3][5]"] -> GrayLevel[0], 
             UndirectedEdge["Vertex[1][9]", "Vertex[3][9]"] -> GrayLevel[0], 
             UndirectedEdge["Vertex[1][11]", "Vertex[3][11]"] -> {
               GrayLevel[0], 
               Dashing[{Small, Small}]}, 
             UndirectedEdge["Vertex[1][10]", "Vertex[3][9]"] -> GrayLevel[0], 
             UndirectedEdge["Vertex[1][6]", "Vertex[3][6]"] -> GrayLevel[0], 
             UndirectedEdge["Vertex[1][12]", "Vertex[3][11]"] -> {
               GrayLevel[0], 
               Dashing[{Small, Small}]}, 
             UndirectedEdge["Vertex[1][8]", "Vertex[3][7]"] -> {
               GrayLevel[0], 
               Dashing[{Small, Small}]}}, FormatType -> TraditionalForm}]]}, 
        TagBox[GraphicsGroupBox[{
           {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], {
             {GrayLevel[0], Dashing[{Small, Small}], 
              {Arrowheads[0.], 
               ArrowBox[{{0., 0.8563488385776752}, {0.42817441928883765`, 
                1.7126976771553504`}}, 0.030219588170803516`]}}, InsetBox[
              InterpretationBox[Cell[BoxData[
                FormBox["\<\"1\"\>", TextForm]], "InlineText",
                Background->GrayLevel[1],ExpressionUUID->
                "eb5833fa-3961-4f49-a474-5dfc604a9b76"],
               Text["1", Background -> GrayLevel[1]]], 
