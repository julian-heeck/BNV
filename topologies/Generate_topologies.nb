              Offset[{-2., 0.}, {2.7831337253774446, 0.4281744192888376}], 
              ImageScaled[{1., 0.5}],
              BaseStyle->"Graphics"]}}, 
           {Hue[0.6, 0.5, 1.], EdgeForm[{GrayLevel[0], Opacity[0.7]}], 
            DiskBox[{0., 0.8563488385776752}, 0.030219588170803516], 
            DiskBox[{0.42817441928883765`, 1.7126976771553504`}, 
             0.030219588170803516], 
            DiskBox[{0.42817441928883765`, 0.}, 0.030219588170803516], 
            DiskBox[{0.8563488385776753, 0.8563488385776752}, 
             0.030219588170803516], 
            DiskBox[{1.284523257866513, 0.}, 0.030219588170803516], 
