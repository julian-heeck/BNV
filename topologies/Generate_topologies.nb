          RowBox[{"lab", "=", 
           RowBox[{"uniqueLabels", "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"posIndices", "=", 
           RowBox[{"Flatten", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"MemberQ", "[", 
                 RowBox[{
                  RowBox[{"clusters", "[", 
                   RowBox[{"[", "t", "]"}], "]"}], ",", "lab"}], "]"}], ",", 
                "t", ",", "Nothing"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"t", ",", 
                RowBox[{"Length", "[", "clusters", "]"}]}], "}"}]}], "]"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "posIndices", "]"}], "<", "1"}], ",", 
            RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"labels", "=", 
           RowBox[{"labelsFromGraph", "[", "newg", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"edgeRule", "=", 
           RowBox[{"FirstCase", "[", 
            RowBox[{
             RowBox[{"Normal", "[", "labels", "]"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Rule", "[", 
                RowBox[{"e_", ",", "val_"}], "]"}], "/;", 
               RowBox[{
                RowBox[{"canon", "[", 
                 RowBox[{"extractText", "[", "val", "]"}], "]"}], "===", 
                RowBox[{"canon", "[", "lab", "]"}]}]}], ":>", "e"}], ",", 
             RowBox[{"Missing", "[", "\"\<NoSuchLabel\>\"", "]"}]}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"edgeRule", "===", 
             RowBox[{"Missing", "[", "\"\<NoSuchLabel\>\"", "]"}]}], ",", 
            RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"srcdst", "=", 
           RowBox[{"List", "@@", "edgeRule"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "posIndices", "]"}], "===", "1"}], ",", 
            RowBox[{"(*", 
             RowBox[{"Leaf", "/", 
              RowBox[{"external", ":", 
               RowBox[{
               "always", " ", "point", " ", "toward", " ", "the", " ", 
                "hub"}]}]}], "*)"}], 
            RowBox[{
             RowBox[{"clCanon", "=", 
              RowBox[{"Sort", "[", 
               RowBox[{"canon", "/@", 
                RowBox[{"clusters", "[", 
                 RowBox[{"[", 
                  RowBox[{"posIndices", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], "]"}]}], ";",
              "\[IndentingNewLine]", 
             RowBox[{"vHub", "=", 
              RowBox[{"FirstCase", "[", 
               RowBox[{
                RowBox[{"Keys", "[", "vertexLabelSets", "]"}], ",", 
                RowBox[{
                 RowBox[{"v_", "/;", 
                  RowBox[{
                   RowBox[{"vertexLabelSets", "[", "v", "]"}], "===", 
                   "clCanon"}]}], ":>", "v"}], ",", 
                RowBox[{"Missing", "[", "\"\<NoHub\>\"", "]"}]}], "]"}]}], ";",
              "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"vHub", "===", 
                RowBox[{"Missing", "[", "\"\<NoHub\>\"", "]"}]}], ",", 
               RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"srcdst", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "=!=", "vHub"}], ",", 
               RowBox[{
                RowBox[{"newg", "=", 
                 RowBox[{"FlipEdgeByLabel", "[", 
                  RowBox[{"newg", ",", "lab"}], "]"}]}], ";", 
                RowBox[{"AppendTo", "[", 
                 RowBox[{"flipped", ",", "lab"}], "]"}]}]}], "]"}]}], ",", 
            RowBox[{"(*", 
             RowBox[{"Internal", ":", 
              RowBox[{
              "point", " ", "from", " ", "earlier", " ", "cluster", " ", 
               "hub", " ", "to", " ", "later", " ", "cluster", " ", "hub"}]}],
              "*)"}], 
            RowBox[{
             RowBox[{"i", "=", 
              RowBox[{"Min", "[", "posIndices", "]"}]}], ";", 
             RowBox[{"j", "=", 
              RowBox[{"Max", "[", "posIndices", "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"clLeftCanon", "=", 
              RowBox[{"Sort", "[", 
               RowBox[{"canon", "/@", 
                RowBox[{"clusters", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"clRightCanon", "=", 
              RowBox[{"Sort", "[", 
               RowBox[{"canon", "/@", 
                RowBox[{"clusters", "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"vFrom", "=", 
              RowBox[{"FirstCase", "[", 
               RowBox[{
                RowBox[{"Keys", "[", "vertexLabelSets", "]"}], ",", 
                RowBox[{
                 RowBox[{"v_", "/;", 
                  RowBox[{
                   RowBox[{"vertexLabelSets", "[", "v", "]"}], "===", 
                   "clLeftCanon"}]}], ":>", "v"}], ",", 
                RowBox[{"Missing", "[", "\"\<NoHub\>\"", "]"}]}], "]"}]}], ";",
              "\[IndentingNewLine]", 
             RowBox[{"vTo", "=", 
              RowBox[{"FirstCase", "[", 
               RowBox[{
                RowBox[{"Keys", "[", "vertexLabelSets", "]"}], ",", 
                RowBox[{
                 RowBox[{"v_", "/;", 
                  RowBox[{
                   RowBox[{"vertexLabelSets", "[", "v", "]"}], "===", 
                   "clRightCanon"}]}], ":>", "v"}], ",", 
                RowBox[{"Missing", "[", "\"\<NoHub\>\"", "]"}]}], "]"}]}], ";",
              "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"vFrom", "===", 
                 RowBox[{"Missing", "[", "\"\<NoHub\>\"", "]"}]}], "||", 
                RowBox[{"vTo", "===", 
                 RowBox[{"Missing", "[", "\"\<NoHub\>\"", "]"}]}]}], ",", 
               RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"srcdst", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "=!=", "vFrom"}], ",", 
               RowBox[{
                RowBox[{"newg", "=", 
                 RowBox[{"FlipEdgeByLabel", "[", 
                  RowBox[{"newg", ",", "lab"}], "]"}]}], ";", 
                RowBox[{"AppendTo", "[", 
                 RowBox[{"flipped", ",", "lab"}], "]"}]}]}], "]"}]}]}], 
           "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"Length", "[", "uniqueLabels", "]"}]}], "}"}]}], "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"ReturnFlipped", ",", 
         RowBox[{"{", 
          RowBox[{"newg", ",", "flipped"}], "}"}], ",", "newg"}], "]"}]}]}], 
     "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Final", " ", "function"}], ",", " ", 
     RowBox[{
     "takes", " ", "one", " ", "of", " ", "our", " ", "normal", " ", "graphs",
       " ", "and", " ", "returns", " ", "a", " ", "graph", " ", "with", " ", 
      "correct", " ", "momentum", " ", 
      RowBox[{"arrows", ":"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MomentumGraph", "[", "g_Graph", "]"}], ":=", 
    RowBox[{"FixEdgeDirections", "[", 
     RowBox[{
      RowBox[{"MakeDirectedGraph", "[", "g", "]"}], ",", 
      RowBox[{
       RowBox[{"ConvertGraphToTopology", "[", "g", "]"}], "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.969098195124445*^9, 3.969098232671419*^9}, {
