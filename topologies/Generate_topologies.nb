Cell["\<\
The output contains topologically equivalent diagrams, so we load and use \
IGraphM (https://github.com/szhorvat/IGraphM) to eliminate them.
Make sure to cite IGraphM appropriately when using this code for research.\
\>", "Text",
 CellChangeTimes->{{3.936433212650909*^9, 3.93643325447327*^9}, {
  3.936440637273855*^9, 3.9364406508122663`*^9}, {3.967814149730299*^9, 
  3.967814151016755*^9}},ExpressionUUID->"afa34f00-f1b4-4917-ba42-\
48bca38c5a98"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"To", " ", "install", " ", 
    RowBox[{"IGraphM", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
  "Get", "[", \
"\"\<https://raw.githubusercontent.com/szhorvat/IGraphM/master/IGInstaller.m\>\
\"", "]"}], 
  StyleBox[" ",
   FontWeight->"Plain"]}]], "Input",ExpressionUUID->"eaf88098-f2af-4e68-b187-\
dd9a7d94a11a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Get", "[", "\"\<IGraphM`\>\"", "]"}], ";"}]], "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"e6bba054-ae28-4c23-9c7f-a0476754cf3c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"irred", "=", 
  RowBox[{"DeleteDuplicates", "[", 
   RowBox[{"listXX", ",", 
