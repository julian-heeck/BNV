   3.936440051364792*^9, 3.936440322711966*^9, 3.936440401781248*^9, 
   3.936441239488873*^9, 3.936441359522053*^9, 3.9364416393075743`*^9, 
   3.936441671351635*^9, 3.9364502209024973`*^9, 3.936450318583252*^9, 
   3.9364508953754272`*^9, 3.936451124409403*^9, 3.936451196619422*^9, 
   3.9364514669600554`*^9, {3.9364530016096573`*^9, 3.936453023417953*^9}, 
   3.97173485403692*^9, 3.972507813272955*^9, 3.972508149344974*^9},
 CellLabel->"Out[15]=",ExpressionUUID->"8197d05f-fa8e-4ab4-866b-5e9de9901ea2"]
