Cell["Now we convert these diagrams to FeynArts\[CloseCurlyQuote] notation:", \
"Text",
 CellChangeTimes->{{3.9364327685068502`*^9, 3.936432780071023*^9}, {
  3.93644005865301*^9, 
  3.93644009387764*^9}},ExpressionUUID->"120cd0b3-80fc-44b0-a85f-\
5deb08f930f8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"treeX", "=", 
   RowBox[{
    RowBox[{"topL", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"top", "[", "1", "]"}], "/@", 
       RowBox[{"ParallelTable", "[", " ", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "OE", ",", "outerEdges", ",", "IncomX", ",", "remainingEdges", ",",
              "InterX", ",", "list", ",", "listX"}], "}"}], ",", "\n", 
           RowBox[{
            RowBox[{"OE", "=", 
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{"EdgeList", "[", 
                RowBox[{"topology", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"VertexDegree", "[", 
                   RowBox[{
                    RowBox[{"topology", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                    RowBox[{"First", "[", "#", "]"}]}], "]"}], "==", "1"}], "||", 
                 RowBox[{
                  RowBox[{"VertexDegree", "[", 
                   RowBox[{
                    RowBox[{"topology", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                    RowBox[{"Last", "[", "#", "]"}]}], "]"}], "==", "1"}]}], 
                "&"}]}], "]"}]}], " ", 
            RowBox[{"(*", " ", 
             RowBox[{
             "selecting", " ", "the", " ", "outer", " ", "incoming", " ", 
              "particles"}], " ", "*)"}], " ", ";", "\n", 
            RowBox[{"outerEdges", "=", 
             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Sort", "[", 
                 RowBox[{"#", ",", "Greater"}], "]"}], "&"}], ",", 
               RowBox[{"OE", "/.", 
                RowBox[{
                 RowBox[{
                  RowBox[{"a_", "\[UndirectedEdge]", "b_"}], "/;", 
                  RowBox[{
                   RowBox[{"Count", "[", 
                    RowBox[{
                    RowBox[{"OE", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", "a"}], 
                    "]"}], ">", "1"}]}], ":>", 
                 RowBox[{"b", "\[UndirectedEdge]", "a"}]}]}]}], "]"}]}], " ", 
            
            RowBox[{"(*", " ", 
             RowBox[{
              RowBox[{
              "reordering", " ", "the", " ", "the", " ", "list", " ", "OE", " ",
                "such", " ", "that", " ", "it", " ", "is", " ", "ascending", " ",
                "order"}], ";", " ", 
              RowBox[{"required", " ", "by", " ", "FeynArts"}]}], " ", "*)"}],
             ";", "\n", 
            RowBox[{"IncomX", "=", " ", 
             RowBox[{"outerEdges", "/.", 
              RowBox[{
               RowBox[{"a_", "\[UndirectedEdge]", "b_"}], " ", "->", " ", 
               RowBox[{
                RowBox[{"Propagator", "[", "Incoming", "]"}], "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Vertex", "[", "1", "]"}], "[", "a", "]"}], ",", 
                 RowBox[{
                  RowBox[{"Vertex", "[", "3", "]"}], "[", 
                  RowBox[{"b", "+", "4"}], "]"}]}], "]"}]}]}]}], " ", 
            RowBox[{"(*", " ", 
             RowBox[{
             "Making", " ", "the", " ", "incoming", " ", "particles", " ", 
              "like", " ", "FeynArts", " ", "file"}], " ", "*)"}], ";", "\n", 
            
            RowBox[{"remainingEdges", "=", 
             RowBox[{"Complement", "[", 
              RowBox[{
               RowBox[{"EdgeList", "[", 
                RowBox[{"topology", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", "OE"}], "]"}]}], 
            " ", 
            RowBox[{"(*", " ", 
             RowBox[{
             "This", " ", "is", " ", "to", " ", "identify", " ", "the", " ", 
              "propagator"}], " ", "*)"}], ";", "\n", 
            RowBox[{"InterX", "=", 
             RowBox[{"remainingEdges", "/.", 
              RowBox[{
               RowBox[{"a_", "\[UndirectedEdge]", "b_"}], " ", "->", " ", 
               RowBox[{
                RowBox[{"Propagator", "[", "Internal", "]"}], "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Vertex", "[", "3", "]"}], "[", 
                  RowBox[{"a", "+", "4"}], "]"}], ",", 
                 RowBox[{
                  RowBox[{"Vertex", "[", "3", "]"}], "[", 
                  RowBox[{"b", "+", "4"}], "]"}]}], "]"}]}]}]}], " ", 
            RowBox[{"(*", " ", 
             RowBox[{
             "Making", " ", "the", " ", "incoming", " ", "particles", " ", 
              "like", " ", "FeynArts", " ", "file"}], " ", "*)"}], ";", "\n", 
            
            RowBox[{"list", "=", 
             RowBox[{"Join", "[", 
              RowBox[{"IncomX", ",", "InterX"}], "]"}]}]}]}], "\n", "]"}], 
         "\n", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "topology", "]"}]}], "}"}]}], "]"}]}], "/.", 
      RowBox[{
       RowBox[{
        RowBox[{"top", "[", "n_", "]"}], "[", "list_List", "]"}], ":>", 
       RowBox[{
        RowBox[{"Topology", "[", "n", "]"}], "[", 
        RowBox[{"Sequence", "@@", "list"}], "]"}]}]}], "]"}], "/.", 
    RowBox[{
     RowBox[{"topL", "[", "list_", "]"}], ":>", 
     RowBox[{"TopologyList", "[", 
      RowBox[{"Sequence", "@@", "list"}], "]"}]}]}]}], ";"}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"841e9313-ae60-4b0e-9a82-e33e6327faa3"],

Cell["\<\
Now we thread the external particles through these diagrams in all ways \
allowed by the FFS, SSS, SSSS vertices:\
\>", "Text",
 CellChangeTimes->{{3.936432888496131*^9, 3.936432913496879*^9}, {
  3.936440179078414*^9, 
  3.9364401990146*^9}},ExpressionUUID->"051bfd4a-b47e-4540-9180-3be4eb12ee0c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "need", " ", "to", " ", "do", " ", "permutation", " ", "of", " ", 
     "incoming", " ", "particles", " ", "to", " ", "get", " ", "all", " ", 
     "the", " ", "topologies"}], ",", " ", 
    RowBox[{
    "such", " ", "that", " ", "scalars", " ", "are", " ", "properly", " ", 
     "placed", " ", "with", " ", "all", " ", "the", " ", "permutations"}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"IncomingParticles", "=", 
     RowBox[{"Permutations", "[", "ListofincomingParticles", "]"}]}], " ", 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Defining", " ", "the", " ", "FeynArts", " ", "code", " ", "to", " ", 
      "insert", " ", "incoming", " ", "particles"}], ",", " ", "\n", 
     RowBox[{
      RowBox[{"IncomingParticles", "[", 
       RowBox[{"[", "i", "]"}], "]"}], "->", 
      RowBox[{
       RowBox[{
        RowBox[{"{", "}"}], " ", "simily", " ", "means", " ", "all", " ", 
        "the", " ", "particles", " ", "are", " ", "going", " ", "to", " ", 
        "a", " ", "single", " ", "vertex", "\n", "Model"}], "->", 
       RowBox[{"\"\<FeynArtsToyModel\>\"", " ", "imports", " ", "the", " ", 
        "model", " ", "file", " ", "that", " ", "has", " ", "3", " ", "point",
         " ", "and", " ", "4", " ", "point", " ", "vertices", " ", 
        "FFS"}]}]}], ",", "SSS", ",", "SSSS"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"diagsTreeX", "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"InsertFields", "[", 
        RowBox[{"treeX", ",", 
         RowBox[{
          RowBox[{"IncomingParticles", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "->", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"InsertionLevel", "->", 
          RowBox[{"{", "Classes", "}"}]}], ",", 
         RowBox[{"Model", "->", "\"\<FeynArtsToyModel\>\""}]}], "]"}], ",", 
       "\n", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "IncomingParticles", "]"}]}], "}"}]}], 
      "]"}]}], " ", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Here", " ", "FeynArts", " ", "assigns", " ", "the", " ", "topology", " ",
       "with", " ", "the", " ", "model", " ", "file", 
      " ", "\"\<Toymodel\>\""}], " ", "*)"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.936432879794029*^9, 3.9364328856855707`*^9}, {
  3.936433153476507*^9, 3.936433156360174*^9}, {3.936440217716378*^9, 
  3.936440275133868*^9}, {3.936440328566786*^9, 3.936440331318606*^9}, {
  3.936440414854886*^9, 3.936440424352543*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"4a8308b9-41bf-4762-9bbc-bf01099a8a70"],

Cell["\<\
Next, we generate a list of graphs (Feynman diagrams) by taking data from \
diagsTreeX. 
We also sort particle names so that scalars come before fermions, but beyond \
that the particle ordering is arbitrary. 
Internal lines are colored red; fermion lines are solid and boson lines are \
dashed. \
\>", "Text",
 CellChangeTimes->{{3.936440450601471*^9, 3.936440460572847*^9}, {
   3.936440499389814*^9, 3.9364405390798483`*^9}, {3.936440587384433*^9, 
   3.9364406206170263`*^9}, 
   3.9678141713030787`*^9},ExpressionUUID->"715865f1-59fe-4a2f-84b9-\
036572facfdc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"listXX", " ", "=", " ", 
   RowBox[{"Flatten", "[", "\n", 
    RowBox[{
     RowBox[{"Table", "[", "\n", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"diagram", ",", "diagramX"}], "}"}], ",", "\n", 
         RowBox[{
          RowBox[{
           RowBox[{"diagramX", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"diagsTreeX", "[", 
               RowBox[{"[", 
                RowBox[{"l", ",", "i"}], "]"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "/.", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"diagsTreeX", "[", 
                   RowBox[{"[", 
                    RowBox[{"l", ",", "i"}], "]"}], "]"}], "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "1"}], "]"}], "]"}], "[", 
                RowBox[{"[", "k", "]"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"k", ",", 
                 RowBox[{"Length", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"diagsTreeX", "[", 
                    RowBox[{"[", 
                    RowBox[{"l", ",", "i"}], "]"}], "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}]}], "}"}]}], 
              "]"}]}]}], ";", "\n", "  ", 
           RowBox[{"diagram", "=", 
            RowBox[{"SortBy", "[", 
             RowBox[{"diagramX", ",", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"MemberQ", "[", 
                  RowBox[{"#", ",", 
                   RowBox[{"S", "[", "1", "]"}]}], "]"}], ",", "0", ",", 
                 "1"}], "]"}], "&"}]}], "]"}]}], ";"}], 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{
            "This", " ", "is", " ", "to", " ", "make", " ", "the", " ", 
             "output", " ", "for", " ", "incomping", " ", "particles", " ", 
             "such", " ", "that", " ", "scalars", " ", "are", " ", "always", " ",
              "before", " ", "fermions"}], ";", " ", 
            RowBox[{
            "not", " ", "really", " ", "necessary", " ", "but", " ", 
             "relevant", " ", "for", " ", "UV", " ", "completion", " ", 
             "code"}]}], " ", "*)"}], ";", "\n", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{
            "A", " ", "graph", " ", "is", " ", "constructed", " ", "using", " ", 
             RowBox[{"Graph", "[", "..", "]"}], " ", "where", " ", "the", " ",
              "vertices", " ", "and", " ", "edges", " ", "are", " ", 
             "determined", " ", "by", " ", "the", " ", "\"\<diagram\>\"", " ",
              "defined", " ", "above"}], ",", " ", "\n", 
            RowBox[{
            "EdgeStyle", " ", "defines", " ", "the", " ", "style", " ", 
             "depending", " ", "on", " ", "type", " ", "of", " ", "particle", 
             " ", "interaction", " ", "\n", "EdgeColors", " ", "categorizes", 
             " ", "the", " ", "edges", " ", "into", " ", "different", " ", 
             "color", " ", "codes", " ", "based", " ", "on", " ", 
             "particles"}]}], " ", "*)"}], "\n", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Graph", "[", 
             RowBox[{
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"ToString", "[", 
                  RowBox[{
                   RowBox[{"diagram", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "]"}], "\[UndirectedEdge]", 
                 RowBox[{"ToString", "[", 
                  RowBox[{
                   RowBox[{"diagram", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"j", ",", 
                  RowBox[{"Length", "[", "diagram", "]"}]}], "}"}]}], "]"}], ",", 
              RowBox[{"EdgeStyle", "->", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"ToString", "[", 
                    RowBox[{
                    RowBox[{"diagram", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "\[UndirectedEdge]", 
                   RowBox[{"ToString", "[", 
                    RowBox[{
                    RowBox[{"diagram", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "->", 
                  RowBox[{"Which", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"ToString", "[", 
                    RowBox[{
                    RowBox[{"diagram", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", "3", "]"}], "]"}], "]"}], 
                    "==", "\"\<F[1]\>\""}], ",", "Black", ",", 
                    RowBox[{
                    RowBox[{"ToString", "[", 
                    RowBox[{
                    RowBox[{"diagram", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", "3", "]"}], "]"}], "]"}], 
                    "==", "\"\<S[1]\>\""}], ",", 
                    RowBox[{"{", 
                    RowBox[{"Black", ",", "Dashed"}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"ToString", "[", 
                    RowBox[{
                    RowBox[{"diagram", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", "3", "]"}], "]"}], "]"}], 
                    "==", "\"\<F\>\""}], ",", "Red", ",", 
                    RowBox[{
                    RowBox[{"ToString", "[", 
                    RowBox[{
                    RowBox[{"diagram", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", "3", "]"}], "]"}], "]"}], 
                    "==", "\"\<S\>\""}], ",", 
                    RowBox[{"{", 
                    RowBox[{"Red", ",", "Dashed"}], "}"}]}], "]"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"j", ",", 
                   RowBox[{"Length", "[", "diagram", "]"}]}], "}"}]}], 
                "]"}]}], ",", "\n", 
              RowBox[{"EdgeLabels", "->", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"ToString", "[", 
                    RowBox[{
                    RowBox[{"diagram", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "\[UndirectedEdge]", 
                   RowBox[{"ToString", "[", 
                    RowBox[{
                    RowBox[{"diagram", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "->", " ", 
                  RowBox[{"Placed", "[", 
                   RowBox[{
                    RowBox[{"Text", "[", 
                    RowBox[{
                    RowBox[{"ToString", "[", "j", "]"}], ",", 
                    RowBox[{"Background", "->", "White"}]}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"Left", ",", "\"\<Middle\>\""}], "}"}]}], "]"}]}],
                  ",", 
                 RowBox[{"{", 
                  RowBox[{"j", ",", 
                   RowBox[{"Length", "[", "diagram", "]"}]}], "}"}]}], 
                "]"}]}]}], "]"}], ",", 
            RowBox[{"\"\<EdgeColors\>\"", "->", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"Which", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"ToString", "[", 
                   RowBox[{
                    RowBox[{"diagram", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", "3", "]"}], "]"}], "]"}], 
                  "==", "\"\<F[1]\>\""}], ",", "1", ",", 
                 RowBox[{
                  RowBox[{"ToString", "[", 
                   RowBox[{
                    RowBox[{"diagram", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", "3", "]"}], "]"}], "]"}], 
                  "==", "\"\<S[1]\>\""}], ",", "2", ",", 
                 RowBox[{
                  RowBox[{"ToString", "[", 
                   RowBox[{
                    RowBox[{"diagram", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", "3", "]"}], "]"}], "]"}], 
                  "==", "\"\<F\>\""}], ",", "3", ",", 
                 RowBox[{
                  RowBox[{"ToString", "[", 
                   RowBox[{
                    RowBox[{"diagram", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "[", 
                    RowBox[{"[", "3", "]"}], "]"}], "]"}], 
                  "==", "\"\<S\>\""}], ",", "4"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"j", ",", 
                 RowBox[{"Length", "[", "diagram", "]"}]}], "}"}]}], 
              "]"}]}]}], "}"}]}]}], "\n", "]"}], "\n", ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "1", ",", 
         RowBox[{"Length", "[", "diagsTreeX", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", 
          RowBox[{"diagsTreeX", "[", 
           RowBox[{"[", "l", "]"}], "]"}], "]"}]}], "}"}]}], "]"}], ",", 
     "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Number of topologies:  \>\"", ",", 
    RowBox[{"Length", "[", "listXX", "]"}]}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{
  3.936432953753997*^9, {3.936433165813702*^9, 3.936433209939207*^9}, {
   3.9364404464153748`*^9, 3.936440448615559*^9}, {3.936453058943048*^9, 
