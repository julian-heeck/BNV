Notebook[{
Cell["\<\
Code developed for, and used in, the following publication, please cite \
appropriately:

Opening up baryon-number-violating operators
Julian Heeck, Diana Sokhashvili, Anil Thapa
arXiv:2603.17050
https://arxiv.org/abs/2603.17050

Related code and more information can also be found at
https://julian-heeck.github.io/BNV/\
\>", "Text",
 CellChangeTimes->{{3.9678144630466623`*^9, 3.967814559293406*^9}, 
   3.973868183672406*^9, {3.982871907680003*^9, 3.982871909639237*^9}, {
   4.003934870728239*^9, 4.003934874552979*^9}, 
   4.003934904681951*^9},ExpressionUUID->"b47d2dfd-d080-4c15-86e6-\
3f6a21047dbf"],

Cell[CellGroupData[{

Cell["Generate tree-level Feynman-diagram topologies", "Title",
 CellChangeTimes->{{3.93643182739277*^9, 
  3.9364318439688168`*^9}},ExpressionUUID->"e7a5446d-34f3-4ece-b0b7-\
b099ea80c5e5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Set", " ", "the", " ", "working", " ", "directory", " ", "as", " ", 
    "notebook", " ", "Directory"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}]}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"a91b07ac-8781-466a-8934-40ba11cf369a"],

Cell[CellGroupData[{

Cell["Generate topologically inequivalent tree graphs", "Section",
 CellChangeTimes->{{3.936431851550773*^9, 
  3.936431884805365*^9}},ExpressionUUID->"cd2e395e-4c9e-440c-8e0c-\
946883d4827e"],

Cell["\<\
First, we generate the topologies. Our procedure  is  to  define  a  function \
 \[OpenCurlyDoubleQuote]addVertices\[CloseCurlyDoubleQuote]  that  takes  a  \
list  of  graphs  and  generates  new  graphs  by  adding  vertices  and  \
edges  to  existing  vertices  in  each  graph. In essence, it adds one \
internal particle line or propagator.
The key part is If[VertexDegree[g, v] == 1, ...], which  checks  if  a vertex \
has  degree  1, i.e. is an external particle.  If  true,  it  proceeds  to  \
create  new  graph  by  adding  edges  connected  to  this  vertex. We only \
add cubic and quartic vertices since we are interested in renormalizable \
interactions.\
\>", "Text",
 CellChangeTimes->{{3.9364394108372393`*^9, 3.9364396198804483`*^9}, {
   3.9364396724085007`*^9, 3.936439713488666*^9}, 
   3.9678143643998528`*^9},ExpressionUUID->"b279cfa0-57a1-4bac-b3ee-\
1cf5f5b2c915"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"addVertices", "[", "graphlist_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "graphs", "}"}], ",", 
     RowBox[{
      RowBox[{"graphs", "=", 
       RowBox[{"ParallelMap", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"g", ",", 
           RowBox[{"Flatten", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"With", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"v", "=", 
                  RowBox[{
                   RowBox[{"VertexList", "[", "g", "]"}], "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"VertexDegree", "[", 
                    RowBox[{"g", ",", "v"}], "]"}], "==", "1"}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Graph", "[", 
                    RowBox[{"Join", "[", 
                    RowBox[{
                    RowBox[{"EdgeList", "[", "g", "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"v", "<->", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"VertexCount", "[", "g", "]"}], "+", "1"}], 
                    ")"}]}], ",", 
                    RowBox[{"v", "<->", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"VertexCount", "[", "g", "]"}], "+", "2"}], 
                    ")"}]}]}], "}"}]}], "]"}], "]"}], ",", 
                    RowBox[{"Graph", "[", 
                    RowBox[{"Join", "[", 
                    RowBox[{
                    RowBox[{"EdgeList", "[", "g", "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"v", "<->", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"VertexCount", "[", "g", "]"}], "+", "1"}], 
                    ")"}]}], ",", 
                    RowBox[{"v", "<->", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"VertexCount", "[", "g", "]"}], "+", "2"}], 
                    ")"}]}], ",", 
                    RowBox[{"v", "<->", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"VertexCount", "[", "g", "]"}], "+", "3"}], 
                    ")"}]}]}], "}"}]}], "]"}], "]"}]}], "}"}], ",", 
                  "Nothing"}], "]"}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", 
                RowBox[{"VertexCount", "[", "g", "]"}]}], "}"}]}], "]"}], 
            "]"}]}], "]"}], ",", "graphlist"}], "]"}]}], ";", "\n", 
      RowBox[{"DeleteDuplicatesBy", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", "graphs", "]"}], ",", "CanonicalGraph"}], 
       "]"}]}]}], "]"}]}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Defining", " ", "the", " ", "foundational", " ", "graphs", " ", 
     "without", " ", "any", " ", "internal", " ", 
     RowBox[{"lines", "/", "propagators"}]}], ",", " ", 
    RowBox[{
     RowBox[{"i", ".", "e", ".", " ", "a"}], " ", "cubic", " ", "vertex", " ",
      "and", " ", "a", " ", "quartic", " ", "vertex"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"prop", "[", "0", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Graph", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"UndirectedEdge", "[", 
          RowBox[{"2", ",", " ", "1"}], "]"}], ",", " ", 
         RowBox[{"UndirectedEdge", "[", 
          RowBox[{"3", ",", " ", "1"}], "]"}], ",", " ", 
         RowBox[{"UndirectedEdge", "[", 
          RowBox[{"4", ",", " ", "1"}], "]"}]}], "}"}], "]"}], ",", 
      RowBox[{"Graph", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"UndirectedEdge", "[", 
          RowBox[{"2", ",", " ", "1"}], "]"}], ",", " ", 
         RowBox[{"UndirectedEdge", "[", 
          RowBox[{"3", ",", " ", "1"}], "]"}], ",", " ", 
         RowBox[{"UndirectedEdge", "[", 
          RowBox[{"4", ",", " ", "1"}], "]"}], ",", 
         RowBox[{"UndirectedEdge", "[", 
          RowBox[{"5", ",", " ", "1"}], "]"}]}], "}"}], "]"}]}], "}"}]}], 
   ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Nesting", " ", "process", " ", "to", " ", "generate", " ", "graphs", " ",
      "by", " ", "repeatedly", " ", "appling", " ", "addVertices", " ", 
     "function"}], ",", " ", 
    RowBox[{"where", " ", "the", " ", "initial", " ", "graph", " ", "is", " ", 
     RowBox[{"prop", "[", "0", "]"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"NumberofPropagators", "=", "3"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "determines", " ", "how", " ", "many", " ", "times", " ", "addVertices", " ",
      "will", " ", "be", " ", "applied"}], ";", " ", 
    RowBox[{"change", " ", "this", " ", "number", " ", "accordingly"}]}], " ",
    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"props", "=", 
  RowBox[{"Flatten", "[", 
   RowBox[{"NestList", "[", 
    RowBox[{"addVertices", ",", 
     RowBox[{"prop", "[", "0", "]"}], ",", "NumberofPropagators"}], "]"}], 
   "]"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.936381020695508*^9, 3.93638104916632*^9}, {
   3.9363810890464153`*^9, 3.936381183638651*^9}, {3.936381300870019*^9, 
   3.936381360125609*^9}, {3.936381478429137*^9, 3.936381533628495*^9}, {
